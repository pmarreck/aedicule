#!/usr/bin/env bash

set -u

if [[ ${AEDICULE_TEST_SHELL:-0} != 1 ]]; then
	develop=(nix develop --ignore-environment --keep HOME)
	if [[ -n ${TMPDIR:-} ]]; then
		develop+=(--keep TMPDIR)
	fi
	if [[ -n ${CARGO_TARGET_DIR:-} ]]; then
		develop+=(--keep CARGO_TARGET_DIR)
	fi
	export XDG_CACHE_HOME="${CARGO_TARGET_DIR:-$PWD/target}/aedicule-test-cache"
	develop+=(--keep XDG_CACHE_HOME)
	exec "${develop[@]}" -c env AEDICULE_TEST_SHELL=1 "$0" "$@"
fi

source tests/lib/capture.bash
source tests/lib/parallel_checks.bash

failures=0

run_check() {
	local out= err= rc=0
	capture "$@"
	if (( rc != 0 )); then
		if [[ -n $out ]]; then
			printf '%s\n' "$out"
		fi
		if [[ -n $err ]]; then
			printf '%s\n' "$err" >&2
		fi
		failures=$((failures + 1))
		return 1
	fi
	return 0
}

run_web_build() {
	local out= err= rc=0 unexpected= line
	capture "$@"
	if (( rc != 0 )); then
		printf 'browser compilation failed:\n%s\n%s\n' "$out" "$err" >&2
		failures=$((failures + 1))
		return
	fi

	while IFS= read -r line; do
		case "$line" in
			''|'  |'|\
			'warning: unstable feature specified for `-Ctarget-feature`: `atomics`'|\
			'  = note: this feature is not stably supported; its behavior can change in the future'|\
			warning:\ *warning*\ emitted)
				;;
			*)
				unexpected+="$line"$'\n'
				;;
		esac
	done <<< "$err"

	if [[ -n $out || -n $unexpected ]]; then
		printf 'browser compilation emitted unexpected diagnostics:\n%s%s\n' \
			"$out" "$unexpected" >&2
		failures=$((failures + 1))
	fi
}

# Produces the exact debug frontplane exercised by the packaged browser probe
# while running every GUI unit and CLI integration test in one Cargo graph.
prepare_gui_binary() {
	cargo test --no-default-features --features gui-test-support --bin aedicule --test gui_cli
}

# Realizes the immutable browser runtime concurrently with the GUI test graph.
prepare_browser_runtime() {
	nix build .#webRuntime --no-link --print-out-paths >"$browser_runtime_file"
}

# Builds the two browser prerequisites concurrently, then exercises the real
# packaged application only when Cargo and Nix both produced current artifacts.
run_packaged_audio_browser() {
	local out= err= rc=0 runtime binary browser_runtime_file status
	if [[ $(uname -s) != Linux || $(uname -m) != x86_64 ]]; then
		return 0
	fi
	browser_runtime_file=$(mktemp "${TMPDIR:-/tmp}/aedicule-browser-runtime.XXXXXX")
	run_parallel_checks prepare_gui_binary prepare_browser_runtime
	status=$?
	if (( status != 0 )); then
		rm -f -- "$browser_runtime_file"
		return "$status"
	fi
	runtime=$(<"$browser_runtime_file")
	rm -f -- "$browser_runtime_file"
	binary="${CARGO_TARGET_DIR:-target}/debug/aedicule"
	if ! [[ -x $binary ]]; then
		printf 'browser host binary is missing after the GUI test build: %s\n' \
			"$binary" >&2
		return 1
	fi
	capture ./tests/integration/web_packaged_audio \
		"$binary" "$runtime" demos/vibesteroids.aed
	if (( rc != 0 )); then
		printf '%s%s\n' "$out" "$err" >&2
		return 1
	fi
}

# Runs runtime/backend checks that share no mutable process state with the
# browser lane, allowing both lanes to overlap without weakening isolation.
run_remaining_checks() {
	local failures=0
	run_check node ./tests/integration/web_browser_startup_unit.mjs
	run_check cargo test --no-default-features --features native-runtime
	run_check cargo test --no-default-features --features portable-runtime
	run_check cargo test --lib --no-default-features --features web web::tests
	run_web_build nix develop .#web --quiet --ignore-environment --keep HOME --keep TMPDIR -c \
		cargo --quiet --config web/cargo-config.toml build --lib --target wasm32-unknown-unknown --no-default-features --features portable-runtime
	run_web_build nix develop .#web --quiet --ignore-environment --keep HOME --keep TMPDIR -c \
		cargo --quiet --config web/cargo-config.toml build --bin aedicule-web --target wasm32-unknown-unknown --no-default-features --features web
	if (( failures > 255 )); then
		return 255
	fi
	return "$failures"
}

run_parallel_checks \
	run_packaged_audio_browser \
	run_remaining_checks \
	./tests/cli/development_dependencies \
	./tests/cli/repository_boundary \
	./tests/cli/aedicule_naming \
	./tests/cli/launcher_cwd \
	./tests/cli/web_startup_surface \
	./tests/cli/delivery_matrix \
	./tests/cli/document_packages \
	./tests/cli/demo_snapshots \
	./tests/cli/macos_reproducibility \
	./tests/cli/reproducible_releases \
	./tests/cli/publish \
	./tests/cli/web_i18n \
	./tests/cli/github_pages \
	./tests/cli/ci_acceleration \
	./tests/cli/rust_dependency_cache \
	./tests/cli/native_parallelism \
	./tests/cli/parallel_test_runner \
	./tests/cli/frontplane_tools \
	./tests/cli/web_delivery \
	./tests/cli/build_partition
failures=$((failures + $?))

if (( failures > 255 )); then
	exit 255
fi
exit "$failures"
