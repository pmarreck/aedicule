#!/usr/bin/env bash

set -u

root=$(cd "$(dirname "$0")/../.." && pwd -P)

node --input-type=module - "$root" <<'TEST'
import assert from "node:assert/strict";
import { pathToFileURL } from "node:url";

const root = process.argv[2];
const i18n = await import(pathToFileURL(`${root}/packaging/web/launcher-i18n.mjs`));
assert.deepEqual(i18n.supportedLocales, [
	"am", "ar", "az", "bg", "bn", "bs", "da", "de", "el", "en",
	"es", "fa", "fi", "fil", "fr", "ha", "he", "hi", "hr", "hu",
	"id", "ig", "is", "it", "ja", "km", "ko", "mk", "nb", "nl",
	"pa", "pl", "ps", "pt_br", "ro", "ru", "sl", "sq", "sr", "sv",
	"sw", "ta", "th", "tr", "uk", "ur", "vi", "yo", "zh_hans", "zh_hant",
]);
assert.deepEqual(Object.keys(i18n.english).sort(), [
	"aboutAbiLink", "aboutAuthoringBody", "aboutAuthoringTitle", "aboutBack",
	"aboutControlsBody", "aboutControlsTitle", "aboutEyebrow",
	"aboutGraphicsBody", "aboutGraphicsTitle", "aboutGuideLink", "aboutHeadline",
	"aboutInputBody", "aboutInputTitle", "aboutLead", "aboutLink",
	"aboutLiveBody", "aboutLiveTitle", "aboutPackagingBody",
	"aboutPackagingTitle", "aboutSoundBody", "aboutSoundTitle",
	"aboutTargetsAria", "aboutTargetsBody", "aboutTargetsTitle", "aboutTitle",
	"aboutWhyBody", "aboutWhyTitle",
	"assetCatalogEntryLimit", "assetCatalogHttp", "assetCatalogInvalidPath",
	"assetLimit", "assetTotalLimit", "audioPlaybackFailed", "audioUnavailable",
	"audioUnlockFailed", "checkingCapabilities", "chooseApplication",
	"couldNotLoadAsset", "couldNotLoadWat", "couldNotStart", "downloads",
	"intro", "invalidPcmRequest", "loadingApplicationAssets",
	"loadingLocalApplication", "loadingWat", "localApplicationFailed", "no", "open",
	"openLocalDescription", "openLocalTitle", "requiresIsolation",
	"requiresSecureContext", "requiresSharedMemory", "requiresWebGpu", "source",
	"starting", "title", "ulamDescription", "ulamName", "unusableWebGpu",
	"vibesteroidsDescription", "vibesteroidsName", "vibesteroidsPackage",
	"waitingForStartupLock",
	"webGpuAdapterRecovery", "webGpuChromeHelp", "webGpuFirefoxHelp",
	"webGpuRetryHelp", "webGpuSafariHelp", "yes",
]);
assert.equal(i18n.formatMessage(i18n.english.couldNotLoadAsset, {
	name: "assets/a.flac",
	status: 404,
}), "Aedicule could not load package asset assets/a.flac: HTTP 404");
assert.throws(
	() => i18n.formatMessage("{missing}", {}),
	/unknown message value: missing/,
);
assert.equal(i18n.resolveLocale(["fil-PH"]), "fil");
assert.equal(i18n.resolveLocale(["pt-BR"]), "pt_br");
assert.equal(i18n.resolveLocale(["zh"]), "zh_hans");
assert.equal(i18n.resolveLocale(["zh-TW"]), "zh_hant");
assert.equal(i18n.resolveLocale(["zh-Hant-HK"]), "zh_hant");
assert.equal(i18n.directionFor("ar"), "rtl");
assert.equal(i18n.directionFor("en"), "ltr");
const missingWebGpu = i18n.webGpuFailureMessage("missing", i18n.english);
assert.match(missingWebGpu, /about:config/);
assert.match(missingWebGpu, /dom\.webgpu\.enabled/);
assert.match(missingWebGpu, /chrome:\/\/settings\/system/);
assert.match(missingWebGpu, /chrome:\/\/gpu/);
assert.match(missingWebGpu, /Safari 26/);
assert.match(missingWebGpu, /reload this page/i);
assert.match(missingWebGpu, /restart/i);
assert.ok(missingWebGpu.startsWith(i18n.english.requiresWebGpu));
assert.ok(
	i18n.webGpuFailureMessage("adapter", i18n.english)
		.startsWith(i18n.english.unusableWebGpu),
);
assert.throws(
	() => i18n.webGpuFailureMessage("mystery", i18n.english),
	/unknown WebGPU failure kind/,
);

const localizedHeading = {
	dataset: { i18n: "aboutHeadline" },
	textContent: "",
};
const localizedTargets = {
	attributes: {},
	dataset: { i18nAriaLabel: "aboutTargetsAria" },
	setAttribute(name, value) {
		this.attributes[name] = value;
	},
};
const localizedDocument = {
	documentElement: {
		dataset: { i18nTitle: "aboutTitle" },
		dir: "",
		lang: "",
	},
	querySelectorAll(selector) {
		return {
			"[data-i18n]": [localizedHeading],
			"[data-i18n-aria-label]": [localizedTargets],
		}[selector] ?? [];
	},
	title: "",
};
i18n.localizeDocument(localizedDocument, ["en-US"]);
assert.equal(localizedDocument.documentElement.lang, "en");
assert.equal(localizedDocument.documentElement.dir, "ltr");
assert.equal(localizedDocument.title, "About Aedicule");
assert.equal(localizedHeading.textContent, "SIX TARGETS. ONE WAT APPLICATION.");
assert.equal(localizedTargets.attributes["aria-label"], "Aedicule delivery targets");

const warnings = [];
assert.deepEqual(i18n.loadCatalog(["de-DE"], warning => warnings.push(warning)), {
	locale: "en",
	strings: i18n.english,
});
assert.deepEqual(warnings, ["WARN: i18n missing-locale de"]);
TEST
