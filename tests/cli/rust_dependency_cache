#!/usr/bin/env bash

set -u

root=$(cd "$(dirname "$0")/../.." && pwd -P)
work="$TMPDIR/aedicule-rust-dependency-cache-$$"
snapshot="$work/snapshot"
failures=0
trap 'rm -rf -- "$work"' EXIT

if ! rg -F 'develop+=(--keep CARGO_TARGET_DIR)' "$root/test" >/dev/null; then
	printf 'full suite does not preserve the configured SSD Cargo target cache\n' >&2
	failures=$((failures + 1))
fi

dev_dependencies=$(
	sed -n '/^\[dev-dependencies\]$/,/^\[/p' "$root/Cargo.toml"
)
if rg -q '^gpui = ' <<< "$dev_dependencies"; then
	printf 'headless runtime tests still activate GPUI through dev-dependencies\n' >&2
	failures=$((failures + 1))
fi

if ! rg -F 'gui-test-support = ["gui", "gpui/test-support"]' \
	"$root/Cargo.toml" >/dev/null; then
	printf 'GUI test support is not isolated behind its explicit feature\n' >&2
	failures=$((failures + 1))
fi

gui_test_command='cargo test --no-default-features --features gui-test-support --bin aedicule --test gui_cli'
if ! rg -F "$gui_test_command" "$root/test" >/dev/null; then
	printf 'full suite does not compile all GUI tests in one feature-graph pass\n' >&2
	failures=$((failures + 1))
fi

if ! rg -F "$gui_test_command" "$root/flake.nix" >/dev/null; then
	printf 'isolated Nix gate does not compile all GUI tests in one feature-graph pass\n' >&2
	failures=$((failures + 1))
fi

if ! rg -U '\[profile\.test\.package\."\*"\]\ndebug = false' \
	"$root/Cargo.toml" >/dev/null; then
	printf 'test dependencies still emit full debug information\n' >&2
	failures=$((failures + 1))
fi

if rg -F 'run_check cargo check' "$root/test" >/dev/null; then
	printf 'full suite still recompiles the default graph for a redundant cargo check\n' >&2
	failures=$((failures + 1))
fi
if rg -q '^[[:space:]]*cargo check$' "$root/flake.nix"; then
	printf 'isolated Nix suite still recompiles the default graph for a redundant cargo check\n' >&2
	failures=$((failures + 1))
fi

browser_runner=$(sed -n '/^run_packaged_audio_browser() {$/,/^}$/p' "$root/test")
if ! rg -F 'run_parallel_checks prepare_gui_binary prepare_browser_runtime' \
	<<< "$browser_runner" >/dev/null; then
	printf 'browser probe serializes its two independent build prerequisites\n' >&2
	failures=$((failures + 1))
fi
if rg -F 'cargo --quiet build --bin aedicule' <<< "$browser_runner" >/dev/null; then
	printf 'browser probe redundantly recompiles the GUI binary\n' >&2
	failures=$((failures + 1))
fi
if ! rg -F 'if ! [[ -x $binary ]]' <<< "$browser_runner" >/dev/null; then
	printf 'browser probe does not require the already-tested GUI binary\n' >&2
	failures=$((failures + 1))
fi

system=$(nix eval --impure --raw --expr builtins.currentSystem 2>/dev/null)
status=$?
if (( status != 0 )); then
	printf 'could not resolve the current Nix system\n' >&2
	exit 1
fi

artifact="packages.$system.cargo-artifacts-native.drvPath"
if ! nix eval --raw "$root#$artifact" >/dev/null 2>&1; then
	printf 'flake does not expose the reusable native Cargo dependency artifact\n' >&2
	exit 1
fi

if ! rg -F 'cargoBuildSourceName = "aedicule-build-source";' "$root/flake.nix" >/dev/null; then
	printf 'flake does not declare one stable Cargo build-source name\n' >&2
	failures=$((failures + 1))
fi

source_name_uses=$(rg -F -c 'name = cargoBuildSourceName;' "$root/flake.nix")
if [[ $source_name_uses != 2 ]]; then
	printf 'production and test source snapshots do not share the Cargo build-source name\n' >&2
	failures=$((failures + 1))
fi

mkdir -p "$snapshot"
tar -C "$root" --exclude=.git --exclude=target --exclude=result \
	--exclude=result-all --exclude=result-web -cf - . | tar -C "$snapshot" -xf -

before=$(nix eval --raw "$snapshot#$artifact" 2>/dev/null)
status=$?
if (( status != 0 )); then
	printf 'could not evaluate the dependency artifact from an isolated source snapshot\n' >&2
	exit 1
fi

printf '\n// Dependency-cache classifier source-only mutation.\n' >> "$snapshot/src/lib.rs"
after=$(nix eval --raw "$snapshot#$artifact" 2>/dev/null)
status=$?
if (( status != 0 )); then
	printf 'could not re-evaluate the dependency artifact after a source-only change\n' >&2
	exit 1
fi

if [[ $before != "$after" ]]; then
	printf 'a source-only Rust change invalidated the reusable dependency artifact\n' >&2
	failures=$((failures + 1))
fi

exit "$failures"
