#!/usr/bin/env bash

set -u

root=$(cd "$(dirname "$0")/../.." && pwd -P)
work="$TMPDIR/aedicule-rust-dependency-cache-$$"
snapshot="$work/snapshot"
failures=0
trap 'rm -rf -- "$work"' EXIT

system=$(nix eval --impure --raw --expr builtins.currentSystem 2>/dev/null)
status=$?
if (( status != 0 )); then
	printf 'could not resolve the current Nix system\n' >&2
	exit 1
fi

artifact="packages.$system.cargo-artifacts-native.drvPath"
if ! nix eval --raw "$root#$artifact" >/dev/null 2>&1; then
	printf 'flake does not expose the reusable native Cargo dependency artifact\n' >&2
	exit 1
fi

if ! rg -F 'cargoBuildSourceName = "aedicule-build-source";' "$root/flake.nix" >/dev/null; then
	printf 'flake does not declare one stable Cargo build-source name\n' >&2
	failures=$((failures + 1))
fi

source_name_uses=$(rg -F -c 'name = cargoBuildSourceName;' "$root/flake.nix")
if [[ $source_name_uses != 2 ]]; then
	printf 'production and test source snapshots do not share the Cargo build-source name\n' >&2
	failures=$((failures + 1))
fi

mkdir -p "$snapshot"
tar -C "$root" --exclude=.git --exclude=target --exclude=result \
	--exclude=result-all --exclude=result-web -cf - . | tar -C "$snapshot" -xf -

before=$(nix eval --raw "$snapshot#$artifact" 2>/dev/null)
status=$?
if (( status != 0 )); then
	printf 'could not evaluate the dependency artifact from an isolated source snapshot\n' >&2
	exit 1
fi

printf '\n// Dependency-cache classifier source-only mutation.\n' >> "$snapshot/src/lib.rs"
after=$(nix eval --raw "$snapshot#$artifact" 2>/dev/null)
status=$?
if (( status != 0 )); then
	printf 'could not re-evaluate the dependency artifact after a source-only change\n' >&2
	exit 1
fi

if [[ $before != "$after" ]]; then
	printf 'a source-only Rust change invalidated the reusable dependency artifact\n' >&2
	failures=$((failures + 1))
fi

exit "$failures"
