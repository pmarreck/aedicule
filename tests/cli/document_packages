#!/usr/bin/env bash

set -u

root=$(cd "$(dirname "$0")/../.." && pwd -P)
failures=0

require_text() {
	file=$1
	needle=$2
	if [[ ! -f "$root/$file" ]] || ! rg -F -- "$needle" "$root/$file" >/dev/null; then
		printf '%s does not declare %s\n' "$file" "$needle" >&2
		failures=$((failures + 1))
	fi
}

for icon in \
	assets/icons/aedicule-app.png \
	assets/icons/aedicule-aed-document.png \
	assets/icons/aedicule-wat-document.png \
	assets/icons/Aedicule.ico \
	assets/icons/Aedicule-WAT.ico; do
	if [[ ! -s "$root/$icon" ]]; then
		printf '%s is missing or empty\n' "$icon" >&2
		failures=$((failures + 1))
	fi
done

require_text packaging/macos/Info.plist.in CFBundleDocumentTypes
require_text packaging/macos/Info.plist.in UTImportedTypeDeclarations
require_text packaging/macos/Info.plist.in UTExportedTypeDeclarations
require_text packaging/macos/Info.plist.in org.webassembly.wat
require_text packaging/macos/Info.plist.in dev.aedicule.application
require_text packaging/macos/Info.plist.in application/vnd.aedicule.app+zip
require_text packaging/macos/Info.plist.in AediculeAED.icns
require_text packaging/macos/Info.plist.in '<string>aed</string>'
require_text packaging/macos/Info.plist.in CFBundleTypeIconFile
require_text packaging/macos/Info.plist.in '<string>11.0</string>'
require_text flake.nix 'MACOSX_DEPLOYMENT_TARGET = "11.0";'
require_text flake.nix 'assets/icons/aedicule-aed-document.png'
require_text flake.nix 'Contents/Resources/AediculeAED.icns'
require_text packaging/linux/aedicule.desktop 'Exec=aedicule %f'
require_text packaging/linux/aedicule.desktop 'MimeType=text/x-webassembly-wat;'
require_text packaging/linux/aedicule-launcher.in '@LOADER@'
require_text packaging/linux/aedicule-launcher.in 'LD_LIBRARY_PATH'
require_text packaging/linux/org.webassembly.wat.xml 'glob pattern="*.wat"'
require_text packaging/windows/install-file-association.ps1 'Aedicule.WAT'
require_text packaging/windows/install-file-association.ps1 '"%1"'
require_text packaging/windows/aedicule.rc 'Aedicule.ico'
require_text README.md 'macOS registers both `.wat` and `.aed` document types'
require_text flake.nix 'runtimeDll'
require_text flake.nix 'cp -L "$runtimeDll" $out/'
require_text flake.nix '$out/Tools/install-file-association.ps1'
require_text packaging/web/manifest.webmanifest '"name": "Aedicule"'
require_text web/index.html 'rel="icon"'
require_text web/index.html 'rel="manifest"'
require_text flake.nix 'cp ${./demos/manifest.tsv} $out/manifest.tsv'
require_text flake.nix 'cp -R ${self.packages.${system}.webRuntime}/. $out/share/aedicule/web/'
require_text flake.nix 'cp -R ${self.packages.${system}.webRuntime}/. $out/Web/'
require_text flake.nix 'cp -R ${self.packages.${system}.webRuntime}/. $app/Contents/Resources/Web/'
require_text flake.nix '--set AEDICULE_WEB_RUNTIME ${self.packages.${system}.webRuntime}'
require_text src/web_server.rs 'Cross-Origin-Embedder-Policy: require-corp'
require_text src/web_server.rs 'Cross-Origin-Opener-Policy: same-origin'

library_scan_loops=$(rg -F 'for libraryDirectory in "$storePath/lib" "$storePath/lib64"; do' \
	"$root/flake.nix" | wc -l)
if (( library_scan_loops != 1 )); then
	printf 'Linux delivery must scan each closure library directory exactly once\n' >&2
	failures=$((failures + 1))
fi

exit "$failures"
