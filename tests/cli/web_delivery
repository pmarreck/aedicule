#!/usr/bin/env bash

set -u

root=$(cd "$(dirname "$0")/../.." && pwd -P)
source "$root/tests/lib/capture.bash"

out_link="$TMPDIR/aedicule-web-delivery-result"
rm -f "$out_link"
trap 'rm -f "$out_link"' EXIT

out=
err=
rc=0
capture nix build --out-link "$out_link" "$root#webFallback"

failures=0
if (( rc != 0 )); then
	printf 'web fallback delivery build failed:\n%s\n' "$err" >&2
	failures=$((failures + 1))
else
	for asset in index.html bootstrap.js audio.mjs motion-input.mjs touch-input.mjs local-application.mjs startup-lock.mjs service-worker-retirement.mjs aedicule_web.js code.wat; do
		if [[ ! -s "$out_link/$asset" ]]; then
			printf 'web fallback delivery is missing non-empty %s\n' "$asset" >&2
			failures=$((failures + 1))
		fi
	done
	mapfile -t runtime_wasm < <(
		cd "$out_link" &&
			rg --files -g 'aedicule_web_bg.*.wasm' |
			rg '^aedicule_web_bg\.[0-9a-f]{64}\.wasm$'
	)
	if (( ${#runtime_wasm[@]} != 1 )); then
		printf 'web fallback delivery has %d content-addressed runtime Wasm files; expected 1\n' \
			"${#runtime_wasm[@]}" >&2
		failures=$((failures + 1))
	elif ! rg -F "${runtime_wasm[0]}" "$out_link/aedicule_web.js" >/dev/null; then
		printf 'web runtime JavaScript does not reference its content-addressed Wasm\n' >&2
		failures=$((failures + 1))
	fi
	if rg -F 'shared:true' "$out_link/aedicule_web.js" >/dev/null; then
		printf 'web runtime still imports shared Wasm memory\n' >&2
		failures=$((failures + 1))
	fi
	if [[ -e "$out_link/coi-serviceworker.js" ]]; then
		printf 'web fallback delivery still includes the obsolete isolation service worker\n' >&2
		failures=$((failures + 1))
	fi
	if [[ -e "$out_link/aedicule_web_bg.wasm" ]]; then
		printf 'web fallback delivery still exposes an unhashed runtime Wasm URL\n' >&2
		failures=$((failures + 1))
	fi
	if ! rg -F 'fetch("./code.wat"' "$out_link/bootstrap.js" >/dev/null; then
		printf 'web fallback delivery bootstrap does not load external code.wat\n' >&2
		failures=$((failures + 1))
	fi
	mapfile -t bootstrap_entries < <(
		rg -o 'bootstrap\.[0-9a-f]{64}\.js' "$out_link/index.html" | sort -u
	)
	if (( ${#bootstrap_entries[@]} != 1 )); then
		printf 'web entry document references %d content-addressed bootstraps; expected 1\n' \
			"${#bootstrap_entries[@]}" >&2
		failures=$((failures + 1))
	else
		bootstrap_entry=${bootstrap_entries[0]}
		if [[ ! -s $out_link/$bootstrap_entry ]]; then
			printf 'web entry document references missing %s\n' "$bootstrap_entry" >&2
			failures=$((failures + 1))
		else
			bootstrap_hash=${bootstrap_entry#bootstrap.}
			bootstrap_hash=${bootstrap_hash%.js}
			actual_hash=$(sha256sum "$out_link/$bootstrap_entry")
			if [[ ${actual_hash%% *} != "$bootstrap_hash" ]]; then
				printf 'bootstrap filename does not identify its content\n' >&2
				failures=$((failures + 1))
			fi
			if ! rg -F "__AEDICULE_WEB_BUILD_ID = \"$bootstrap_hash\"" \
				"$out_link/index.html" >/dev/null; then
				printf 'entry diagnostics do not identify the loaded module graph\n' >&2
				failures=$((failures + 1))
			fi
			mapfile -t imported_modules < <(
				rg -o '\./[A-Za-z0-9_-]+\.[0-9a-f]{64}\.(js|mjs)' \
					"$out_link/$bootstrap_entry" | sed 's|^\./||' | sort -u
			)
			if (( ${#imported_modules[@]} < 8 )); then
				printf 'content-addressed bootstrap has only %d versioned imports; expected at least 8\n' \
					"${#imported_modules[@]}" >&2
				failures=$((failures + 1))
			fi
			for imported in "${imported_modules[@]}"; do
				if [[ ! -s $out_link/$imported ]]; then
					printf 'bootstrap references missing content-addressed module: %s\n' \
						"$imported" >&2
					failures=$((failures + 1))
					continue
				fi
				module_hash=${imported%.*}
				module_hash=${module_hash##*.}
				actual_hash=$(sha256sum "$out_link/$imported")
				if [[ ${actual_hash%% *} != "$module_hash" ]]; then
					printf 'module filename does not identify its content: %s\n' "$imported" >&2
					failures=$((failures + 1))
				fi
			done
		fi
	fi
	if (( ${#runtime_wasm[@]} == 1 )); then
		wasm_bytes=$(stat -c '%s' "$out_link/${runtime_wasm[0]}")
		max_wasm_bytes=$((18 * 1024 * 1024))
		if (( wasm_bytes > max_wasm_bytes )); then
			printf 'web fallback Wasm is %d bytes; delivery budget is %d bytes\n' \
				"$wasm_bytes" "$max_wasm_bytes" >&2
			failures=$((failures + 1))
		fi
	fi
fi

exit "$failures"
