#!/usr/bin/env bash

set -u

root=$(cd "$(dirname "$0")/../.." && pwd -P)
expected_targets=$'linux-aarch64\nlinux-x86_64\nmacos-aarch64\nweb\nwindows-aarch64\nwindows-x86_64'
failures=0

matrix_targets() {
	local workflow=$1 line values
	line=$(rg -m1 '^[[:space:]]+target: \[[^]]+\]$' "$workflow" 2>/dev/null)
	values=${line#*[}
	values=${values%]*}
	printf '%s\n' "$values" | tr ',' '\n' | sed 's/^[[:space:]]*//; s/[[:space:]]*$//' | LC_ALL=C sort
}

require_text() {
	local workflow=$1 needle=$2 description=$3
	if ! rg -F -- "$needle" "$workflow" >/dev/null 2>&1; then
		printf '%s lacks %s\n' "$description" "$needle" >&2
		failures=$((failures + 1))
	fi
}

reject_text() {
	local workflow=$1 needle=$2 description=$3
	if rg -F -- "$needle" "$workflow" >/dev/null 2>&1; then
		printf '%s still contains %s\n' "$description" "$needle" >&2
		failures=$((failures + 1))
	fi
}

for relative in .github/workflows/ci.yml .github/workflows/release.yml; do
	workflow="$root/$relative"
	description=${relative##*/}
	if [[ ! -s $workflow ]]; then
		printf '%s is missing\n' "$relative" >&2
		failures=$((failures + 1))
		continue
	fi

	actual_targets=$(matrix_targets "$workflow")
	if [[ $actual_targets != "$expected_targets" ]]; then
		printf '%s does not classify the exact six-target matrix\n' "$description" >&2
		failures=$((failures + 1))
	fi
	require_text "$workflow" 'nix build ".#release-${{ matrix.target }}"' "$description"
	reject_text "$workflow" 'nix build .#release-all' "$description"
	if ! actionlint "$workflow"; then
		failures=$((failures + 1))
	fi
done

ci="$root/.github/workflows/ci.yml"
require_text "$ci" 'name: Test complete suite' 'CI workflow'
require_text "$ci" 'name: Build ${{ matrix.target }}' 'CI workflow'
require_text "$ci" \
	'uses: Swatinem/rust-cache@c19371144df3bb44fab255c43d04cbc2ab54d1c4 # v2.9.1' \
	'CI workflow'
require_text "$ci" \
	'uses: DeterminateSystems/magic-nix-cache-action@55718cd9ebf1737a061487d5ada21abf31e99a98' \
	'CI workflow'
require_text "$ci" \
	'uses: jlumbroso/free-disk-space@54081f138730dfa15788a46383842cd2f914a1be # v1.3.1' \
	'CI workflow'
if [[ $(rg -F -c \
	'uses: jlumbroso/free-disk-space@54081f138730dfa15788a46383842cd2f914a1be # v1.3.1' \
	"$ci") != 2 ]]; then
	printf 'CI disk cleanup must appear exactly once in test and target jobs\n' >&2
	failures=$((failures + 1))
fi
for cleanup_setting in 'android: true' 'dotnet: true' 'haskell: true' \
	'docker-images: true' 'large-packages: false' 'swap-storage: false' \
	'tool-cache: false'; do
	require_text "$ci" "$cleanup_setting" 'CI hosted-runner disk cleanup'
done
require_text "$ci" 'minimum_free_kib=25000000' 'CI cache-space guard'
require_text "$ci" 'cmd-format: nix develop -c {0}' 'CI workflow'
require_text "$ci" \
	"save-if: \${{ github.event_name == 'push' && github.ref == 'refs/heads/yolo' }}" \
	'CI workflow'
test_job=$(sed -n '/^  test:$/,/^  targets:$/p' "$ci")
cleanup_line=$(rg -n -F 'uses: jlumbroso/free-disk-space@' <<< "$test_job" | cut -d: -f1)
rust_cache_line=$(rg -n -F 'uses: Swatinem/rust-cache@' <<< "$test_job" | cut -d: -f1)
if [[ -z $cleanup_line || -z $rust_cache_line || $cleanup_line -ge $rust_cache_line ]]; then
	printf 'CI disk cleanup does not run before the expanded Rust-cache restore\n' >&2
	failures=$((failures + 1))
fi
target_job=$(sed -n '/^  targets:$/,/^  pages:$/p' "$ci")
target_cleanup_line=$(rg -n -F 'uses: jlumbroso/free-disk-space@' <<< "$target_job" | cut -d: -f1)
target_build_line=$(rg -n -F 'nix build ".#release-${{ matrix.target }}"' <<< "$target_job" | cut -d: -f1)
if [[ -z $target_cleanup_line || -z $target_build_line \
	|| $target_cleanup_line -ge $target_build_line ]]; then
	printf 'CI disk cleanup does not run before each six-target cross-build\n' >&2
	failures=$((failures + 1))
fi
if ! rg -F 'id-token: write' <<< "$test_job" >/dev/null; then
	printf 'CI test job lacks narrowly-scoped id-token permission for its Nix cache\n' >&2
	failures=$((failures + 1))
fi
reject_text "$ci" 'run: nix build --print-build-logs' 'CI workflow'

release="$root/.github/workflows/release.yml"
require_text "$release" './check_reproducible "${{ matrix.target }}"' 'release workflow'
require_text "$release" 'actions/upload-artifact@v4' 'release workflow'
require_text "$release" 'actions/download-artifact@v5' 'release workflow'

# nixpkgs' default cargo install hook copies the complete cross-compilation
# target tree to release-tmp. GPUI's dependency graph can exhaust a clean
# runner after the actual compilation has already succeeded, so cross targets
# must install only the requested executable.
require_text "$root/flake.nix" 'install -Dm755 "$binary" "$out/bin/$binaryName"' 'cross-target packaging'

exit "$failures"
