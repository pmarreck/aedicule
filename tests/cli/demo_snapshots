#!/usr/bin/env bash

set -u

root=$(cd "$(dirname "$0")/../.." && pwd -P)
expected=$'slug\tfile\tsource\tcommit\tsha256\nulam-flower\tulam-flower.wat\thttps://github.com/pmarreck/ulam-flower-wat\t30cc41b4fa6e12b2b691d8eecc9ef490d252d937\t21952a212febf96d102be1ab31424641a7db4fa4255688f19dc55dadae5d0dd7\nvibesteroids\tvibesteroids.wat\thttps://github.com/pmarreck/vibesteroids_wat\t9c50ed24fb446130e36996c59d90d720805c503c\t24180d480477a7de18199caa887c90538756406c4a273a6d9e34b229e8205541\nvibesteroids-package\tvibesteroids.aed\thttps://github.com/pmarreck/vibesteroids_wat\t935740771883497778a7cac977cbb03e655b0a83\tb22e5002651fbe1f55dedaf170bcfda9a95fe06f0f384fa1b2bd79fd6f67867c'
failures=0

if [[ ! -f "$root/demos/manifest.tsv" ]]; then
	printf 'demo provenance manifest is missing\n' >&2
	failures=$((failures + 1))
elif [[ $(<"$root/demos/manifest.tsv") != "$expected" ]]; then
	printf 'demo provenance manifest is not the approved two-snapshot set\n' >&2
	failures=$((failures + 1))
fi

while IFS=$'\t' read -r slug file source commit expected_sha; do
	if [[ "$slug" == slug ]]; then
		continue
	fi
	path="$root/demos/$file"
	if [[ ! -s "$path" ]]; then
		printf 'demo snapshot is missing: %s\n' "$file" >&2
		failures=$((failures + 1))
		continue
	fi
	actual_sha=$(sha256sum "$path" | awk '{print $1}')
	if [[ "$actual_sha" != "$expected_sha" ]]; then
		printf 'demo snapshot hash mismatch: %s\n' "$file" >&2
		failures=$((failures + 1))
	fi
done <<<"$expected"

exit "$failures"
