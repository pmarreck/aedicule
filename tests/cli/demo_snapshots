#!/usr/bin/env bash

set -u

root=$(cd "$(dirname "$0")/../.." && pwd -P)
expected=$'slug\tfile\tsource\tcommit\tsha256\nulam-flower\tulam-flower.wat\thttps://github.com/pmarreck/ulam-flower-wat\t30cc41b4fa6e12b2b691d8eecc9ef490d252d937\t21952a212febf96d102be1ab31424641a7db4fa4255688f19dc55dadae5d0dd7\nvibesteroids\tvibesteroids.wat\thttps://github.com/pmarreck/vibesteroids_wat\te8efd62d0a15eafae7c43d0ed745e6c3b4781cd8\t9af668430386705550db63a5d9f8a7b91bbc11c82aafb481374dcddd14858ac4\nvibesteroids-package\tvibesteroids.aed\thttps://github.com/pmarreck/vibesteroids_wat\te8efd62d0a15eafae7c43d0ed745e6c3b4781cd8\tc7faceb98120cb32e4cfc8f46e6d9a104c5e441ac3979c646e4efada0e5cbf23\nspring-sim\tspring_sim.aed\thttps://github.com/pmarreck/spring_sim_aed\t6e89c4a0d9993540c0f0577b16565c73dccf5438\tce2b757e108737ca45fbc2a809d9444ea32327591c462511634fcbd502291ae3'
failures=0

if [[ ! -f "$root/demos/manifest.tsv" ]]; then
	printf 'demo provenance manifest is missing\n' >&2
	failures=$((failures + 1))
elif [[ $(<"$root/demos/manifest.tsv") != "$expected" ]]; then
	printf 'demo provenance manifest is not the approved snapshot set\n' >&2
	failures=$((failures + 1))
fi

while IFS=$'\t' read -r slug file source commit expected_sha; do
	if [[ "$slug" == slug ]]; then
		continue
	fi
	path="$root/demos/$file"
	if [[ ! -s "$path" ]]; then
		printf 'demo snapshot is missing: %s\n' "$file" >&2
		failures=$((failures + 1))
		continue
	fi
	actual_sha=$(sha256sum "$path" | awk '{print $1}')
	if [[ "$actual_sha" != "$expected_sha" ]]; then
		printf 'demo snapshot hash mismatch: %s\n' "$file" >&2
		failures=$((failures + 1))
	fi
done <<<"$expected"

exit "$failures"
