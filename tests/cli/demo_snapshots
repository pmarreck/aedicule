#!/usr/bin/env bash

set -u

root=$(cd "$(dirname "$0")/../.." && pwd -P)
expected=$'slug\tfile\tsource\tcommit\tsha256\nulam-flower\tulam-flower.wat\thttps://github.com/pmarreck/ulam-flower-wat\t1410f3627506387bb0c0ad912bb4bc5a4ce69677\tf69c41ad947a5a1aa9f29e48aba22bff40fb0568bd18677cf5a36cdddbdff152\nvibesteroids\tvibesteroids.wat\thttps://github.com/pmarreck/vibesteroids_wat\t0ee35e87575ac97a85e9fadbd43c612bbfe1f690\t7b833657e840ce9d664bb682bc13f593f632f85beba4fea3b2cba568ebb26789'
failures=0

if [[ ! -f "$root/demos/manifest.tsv" ]]; then
	printf 'demo provenance manifest is missing\n' >&2
	failures=$((failures + 1))
elif [[ $(<"$root/demos/manifest.tsv") != "$expected" ]]; then
	printf 'demo provenance manifest is not the approved two-snapshot set\n' >&2
	failures=$((failures + 1))
fi

while IFS=$'\t' read -r slug file source commit expected_sha; do
	if [[ "$slug" == slug ]]; then
		continue
	fi
	path="$root/demos/$file"
	if [[ ! -s "$path" ]]; then
		printf 'demo snapshot is missing: %s\n' "$file" >&2
		failures=$((failures + 1))
		continue
	fi
	actual_sha=$(sha256sum "$path" | awk '{print $1}')
	if [[ "$actual_sha" != "$expected_sha" ]]; then
		printf 'demo snapshot hash mismatch: %s\n' "$file" >&2
		failures=$((failures + 1))
	fi
done <<<"$expected"

exit "$failures"
