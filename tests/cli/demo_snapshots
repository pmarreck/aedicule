#!/usr/bin/env bash

set -u

root=$(cd "$(dirname "$0")/../.." && pwd -P)
expected=$'slug\tfile\tsource\tcommit\tsha256\nulam-flower\tulam-flower.wat\thttps://github.com/pmarreck/ulam-flower-wat\t30cc41b4fa6e12b2b691d8eecc9ef490d252d937\t21952a212febf96d102be1ab31424641a7db4fa4255688f19dc55dadae5d0dd7\nvibesteroids\tvibesteroids.wat\thttps://github.com/pmarreck/vibesteroids_wat\td810415e800eb8ae8c077d3e4b18f7ce7af7a506\t854e2fc1a6c084a2f45a409946929468fdc3c642bde12940851f0e8bd8719292\nvibesteroids-package\tvibesteroids.aed\thttps://github.com/pmarreck/vibesteroids_wat\td810415e800eb8ae8c077d3e4b18f7ce7af7a506\t0a67be8c46c48a5a22f954f6b2bcad5e05319c19e4b71fc70379a6de566406c0\nspring-sim\tspring_sim.aed\thttps://github.com/pmarreck/spring_sim_aed\t6e89c4a0d9993540c0f0577b16565c73dccf5438\tce2b757e108737ca45fbc2a809d9444ea32327591c462511634fcbd502291ae3'
failures=0

if [[ ! -f "$root/demos/manifest.tsv" ]]; then
	printf 'demo provenance manifest is missing\n' >&2
	failures=$((failures + 1))
elif [[ $(<"$root/demos/manifest.tsv") != "$expected" ]]; then
	printf 'demo provenance manifest is not the approved snapshot set\n' >&2
	failures=$((failures + 1))
fi

while IFS=$'\t' read -r slug file source commit expected_sha; do
	if [[ "$slug" == slug ]]; then
		continue
	fi
	path="$root/demos/$file"
	if [[ ! -s "$path" ]]; then
		printf 'demo snapshot is missing: %s\n' "$file" >&2
		failures=$((failures + 1))
		continue
	fi
	actual_sha=$(sha256sum "$path" | awk '{print $1}')
	if [[ "$actual_sha" != "$expected_sha" ]]; then
		printf 'demo snapshot hash mismatch: %s\n' "$file" >&2
		failures=$((failures + 1))
	fi
done <<<"$expected"

exit "$failures"
