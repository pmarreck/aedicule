#!/usr/bin/env bash

set -u

root=$(cd "$(dirname "$0")/../.." && pwd -P)
failures=0

expect_text() {
	file=$1
	text=$2
	message=$3
	if ! rg -F -- "$text" "$file" >/dev/null; then
		printf '%s\n' "$message" >&2
		failures=$((failures + 1))
	fi
}

reject_text() {
	file=$1
	text=$2
	message=$3
	if rg -F -- "$text" "$file" >/dev/null; then
		printf '%s\n' "$message" >&2
		failures=$((failures + 1))
	fi
}

expect_text "$root/web/index.html" 'id="aedicule-startup-status"' \
	'browser page has no visible startup status surface'
expect_text "$root/web/index.html" 'aria-live="polite"' \
	'browser startup status does not announce progress or failure accessibly'
# Chromium implements neither property, so the browser gate cannot observe these
# two at runtime; assert them at the source instead. `-webkit-touch-callout` is
# what actually governs the iOS long-press callout.
expect_text "$root/web/index.html" '-webkit-touch-callout: none' \
	'browser page does not suppress the touch long-press callout'
expect_text "$root/web/index.html" '-webkit-tap-highlight-color: transparent' \
	'browser page does not suppress the touch tap highlight'
expect_text "$root/web/bootstrap.js" 'crossOriginIsolated' \
	'browser bootstrap does not preflight cross-origin isolation'
expect_text "$root/web/bootstrap.js" 'await globalThis.__AEDICULE_ISOLATION_READY' \
	'browser bootstrap can race the headerless-host isolation reload'
expect_text "$root/web/coi-serviceworker.js" 'globalThis.__AEDICULE_EARLY_DIAGNOSTICS' \
	'browser isolation adapter exposes no pre-module diagnostic timeline'
for isolation_stage in isolation-registering isolation-registered \
	isolation-ready isolation-reloading isolation-failed; do
	expect_text "$root/web/coi-serviceworker.js" "\"$isolation_stage\"" \
		"browser isolation trace omits $isolation_stage"
done
expect_text "$root/web/bootstrap.js" 'loadCatalog(navigator.languages)' \
	'browser runtime strings do not use the shared prepare-phase locale catalog'
expect_text "$root/web/coi-serviceworker.js" 'Cross-Origin-Embedder-Policy' \
	'headerless static hosts cannot enable shared WebAssembly memory'
expect_text "$root/web/coi-serviceworker.js" 'Cross-Origin-Opener-Policy' \
	'headerless static hosts cannot isolate the browser browsing context'
expect_text "$root/web/bootstrap.js" 'SharedArrayBuffer' \
	'browser bootstrap does not preflight shared WebAssembly memory support'
expect_text "$root/web/bootstrap.js" 'navigator.gpu.requestAdapter()' \
	'browser bootstrap does not preflight an available WebGPU adapter'
expect_text "$root/web/bootstrap.js" 'globalThis.__AEDICULE_STARTUP_TIMELINE' \
	'browser bootstrap exposes no bounded startup timeline for live diagnosis'
expect_text "$root/web/bootstrap.js" 'withExclusiveStartupLock(' \
	'browser startup does not serialize its adapter/Wasm critical section across tabs'
expect_text "$root/flake.nix" 'install -Dm644 ${./web/startup-lock.mjs} $out/startup-lock.mjs' \
	'browser delivery omits the cross-tab startup-lock module'
for lock_stage in startup-lock-requested startup-lock-waiting \
	startup-lock-acquired startup-lock-released; do
	expect_text "$root/web/startup-lock.mjs" "\"$lock_stage\"" \
		"browser startup lock trace omits $lock_stage"
done
expect_text "$root/web/bootstrap.js" 'reportStartupDiagnostic("webgpu-adapter-request"' \
	'browser startup cannot distinguish API presence from adapter allocation'
expect_text "$root/web/bootstrap.js" 'elapsedMs' \
	'browser startup diagnostics have no per-stage elapsed time'
expect_text "$root/web/bootstrap.js" 'errorName' \
	'browser startup failure hides the browser exception class'
expect_text "$root/web/bootstrap.js" 'userAgent' \
	'browser startup failure omits browser identity'
expect_text "$root/web/bootstrap.js" 'serviceWorkerControlled' \
	'browser startup failure omits scoped isolation-controller state'
expect_text "$root/web/bootstrap.js" 'globalThis.__AEDICULE_RUNTIME_DIAGNOSTIC' \
	'browser runtime exposes no sustained frame-progress diagnostic'
expect_text "$root/src/bin/aedicule-web.rs" 'report_browser_frame_started' \
	'browser runtime cannot distinguish a started frame from a completed frame'
expect_text "$root/src/bin/aedicule-web.rs" 'report_browser_frame_completed' \
	'browser runtime cannot prove continued frame completion after first paint'
expect_text "$root/web/bootstrap.js" 'strings.webGpuAdapterRecovery' \
	'browser adapter abort gives no actionable transient-recovery instruction'
expect_text "$root/web/bootstrap.js" 'console.info("[Aedicule startup]", stage, JSON.stringify(detail))' \
	'browser bootstrap does not report successful startup stages to the console'
expect_text "$root/web/bootstrap.js" 'console.error("[Aedicule startup] failed",' \
	'browser bootstrap does not report startup failures to the console'
expect_text "$root/web/bootstrap.js" 'loadApplication().catch(reportStartupFailure)' \
	'browser bootstrap can still reject into an invisible blank page'
# The startup lock's finally reports a release entry after failing work has
# recorded its true last stage, so the failure screen must derive its stage
# through the mask-aware helper, not raw timeline.at(-1) (iPhone OOM of
# 2026-08-04 reported "startup-lock-released" for a wasm-init failure).
expect_text "$root/web/bootstrap.js" 'failedStartupStage(globalThis.__AEDICULE_STARTUP_TIMELINE)' \
	'browser failure screen reads the raw timeline tail the lock release masks'
expect_text "$root/web/bootstrap.js" 'stackExcerpt' \
	'browser failure screen omits the error stack a console-less device needs'
# iOS grants user activation on completed tap-like gestures, never at gesture
# start, so the unlock set must include end-of-gesture events or the resume
# attempt always precedes the activation it needs.
expect_text "$root/web/bootstrap.js" '["pointerdown", "keydown", "touchstart", "pointerup", "touchend", "click"]' \
	'browser audio unlock listens only at gesture start, before iOS grants activation'
expect_text "$root/web/bootstrap.js" 'fetch("./application-assets.json"' \
	'browser bootstrap does not fetch the package asset catalog'
expect_text "$root/web/bootstrap.js" 'globalThis.__AEDICULE_ASSETS' \
	'browser bootstrap does not transfer bounded package assets to Wasm'
expect_text "$root/web/bootstrap.js" 'globalThis.__AEDICULE_PLAY_PCM' \
	'browser bootstrap has no Web Audio sampled-PCM device adapter'
expect_text "$root/web/bootstrap.js" 'globalThis.__AEDICULE_AUDIO_REQUEST_COUNT' \
	'browser sampled-audio adapter exposes no compact request diagnostic'
expect_text "$root/web/bootstrap.js" 'globalThis.__AEDICULE_AUDIO_DIAGNOSTIC' \
	'browser sampled-audio adapter exposes no audio lifecycle diagnostic'
expect_text "$root/web/bootstrap.js" 'schedulePcmPlayback(' \
	'browser bootstrap bypasses the unit-tested Web Audio graph adapter'
expect_text "$root/flake.nix" 'install -Dm644 ${./web/audio.mjs} $out/audio.mjs' \
	'browser runtime delivery omits the unit-tested Web Audio graph adapter'
for audio_stage in unlock-event context-created context-resume-requested \
	context-resumed pcm-requested source-failed; do
	expect_text "$root/web/bootstrap.js" "\"$audio_stage\"" \
		"browser sampled-audio trace omits $audio_stage"
done
for audio_stage in pcm-admitted source-started source-ended; do
	expect_text "$root/web/audio.mjs" "\"$audio_stage\"" \
		"unit-tested browser audio graph omits $audio_stage"
done
expect_text "$root/web/bootstrap.js" 'globalThis.__AEDICULE_SET_AUDIO_PAUSED' \
	'browser sampled-audio adapter cannot preserve playback cursors across guest pause'
expect_text "$root/src/bin/aedicule-web.rs" 'BrowserInputOutcome::Paused' \
	'browser input adapter does not apply host-owned pause transitions'
expect_text "$root/web/audio.mjs" '.createBuffer(' \
	'browser sample adapter does not create an explicit channel-aware PCM buffer'
expect_text "$root/flake.nix" 'install -Dm644 ${./packaging/web/launcher-i18n.mjs} $out/launcher-i18n.mjs' \
	'browser runtime delivery omits its localization catalog'
expect_text "$root/flake.nix" 'FONTCONFIG_FILE = pkgs.writeText "aedicule-test-fonts.conf"' \
	'sandboxed Chrome acceptance has no isolated font-discovery configuration'
expect_text "$root/flake.nix" '<dir>${pkgs.dejavu_fonts}/share/fonts/truetype</dir>' \
	'sandboxed Chrome acceptance does not pin a small deterministic font set'
reject_text "$root/flake.nix" 'FONTCONFIG_FILE = pkgs.makeFontsConf' \
	'sandboxed Chrome acceptance still scans ambient system/profile font roots'
expect_text "$root/src/bin/aedicule-web.rs" 'gpui_platform::single_threaded_web()' \
	'browser entrypoint does not use GPUI embedded-run lifetime ownership'
expect_text "$root/src/bin/aedicule-web.rs" '.run_embedded' \
	'browser entrypoint does not retain the externally driven WebAssembly run loop'
expect_text "$root/src/bin/aedicule-web.rs" 'BrowserRuntime::new_with_assets' \
	'browser entrypoint does not instantiate guests with their admitted asset catalog'
expect_text "$root/src/bin/aedicule-web.rs" 'runtime.ui_snapshot()' \
	'browser adapter ignores accepted guest-authored control placement snapshots'
expect_text "$root/src/bin/aedicule-web.rs" 'Slider::new' \
	'browser adapter does not render declared sliders through GPUI Component'
expect_text "$root/src/bin/aedicule-web.rs" 'Button::new' \
	'browser adapter does not render declared buttons through GPUI Component'
expect_text "$root/src/bin/aedicule-web.rs" 'retain_browser_application(application)' \
	'browser entrypoint drops its strong GPUI application handle'
expect_text "$root/web/Caddyfile" '{$AEDICULE_WEB_LISTEN::8080}' \
	'browser delivery server cannot select a non-default loopback listener'
expect_text "$root/web/Caddyfile" 'bind {$AEDICULE_WEB_BIND:127.0.0.1}' \
	'browser delivery server does not bind its default listener to loopback'
expect_text "$root/web/Caddyfile" 'path_regexp immutable_runtime ^/aedicule_web_bg\.[0-9a-f]{64}\.wasm$' \
	'browser delivery server does not recognize content-addressed runtime Wasm'
expect_text "$root/web/Caddyfile" 'Cache-Control "public, max-age=31536000, immutable"' \
	'browser delivery server does not retain content-addressed runtime Wasm'
expect_text "$root/web/Caddyfile" 'Cache-Control "no-store"' \
	'browser development server can reuse stale mutable application assets'
expect_text "$root/web/coi-serviceworker.js" 'aedicule-runtime-v1' \
	'headerless static hosting does not cache immutable runtime Wasm'
expect_text "$root/web/coi-serviceworker.js" 'cache.match(request)' \
	'headerless static hosting lacks cache-first lookup for content-addressed runtime Wasm'
expect_text "$root/tests/integration/web_browser_startup" 'AEDICULE_BROWSER_TRACE_EVENTS' \
	'headless browser input detail has no opt-in environment gate'
expect_text "$root/src/bin/aedicule-web.rs" '__AEDICULE_TRACE_EVENTS' \
	'browser input tracing stops at the DOM instead of observing frontplane admission'
expect_text "$root/src/bin/aedicule-web.rs" '"[Aedicule input]"' \
	'browser frontplane events cannot be correlated with headless DOM diagnostics'
expect_text "$root/tests/integration/web_browser_startup" 'Input.dispatchMouseEvent' \
	'headless browser probe does not synthesize pointer input through Chrome'
expect_text "$root/tests/integration/web_browser_startup" 'Input.dispatchTouchEvent' \
	'headless browser probe does not synthesize multi-touch input through Chrome'
expect_text "$root/tests/integration/web_browser_startup" 'touchCancel' \
	'headless browser probe does not exercise touch cancellation'
expect_text "$root/tests/integration/web_browser_startup" 'dispatchGhostMousePair' \
	'headless browser probe does not replay iOS Safari compatibility mouse echoes'
expect_text "$root/tests/integration/web_browser_startup" 'ghostActivated' \
	'touch activation verdict tolerates a tap that dispatches twice'
expect_text "$root/tests/integration/web_browser_startup" 'type: "input-summary"' \
	'headless browser probe does not compact its synthetic input result'
expect_text "$root/tests/integration/web_browser_startup" '--require-audio-playback' \
	'headless browser probe cannot require a complete Web Audio lifecycle'
reject_text "$root/tests/integration/web_browser_startup" '--require-audio-request' \
	'headless browser probe still permits the false-green request-only audio gate'
expect_text "$root/tests/integration/web_browser_startup" '--require-key-delivery' \
	'headless browser probe cannot distinguish DOM dispatch from WAT keyboard delivery'
expect_text "$root/tests/integration/web_browser_startup" '--require-controls' \
	'headless browser probe cannot require rendered and guest-delivered AVP controls'
expect_text "$root/tests/integration/web_browser_startup" '--require-external-link' \
	'headless browser probe cannot require trusted AVP external-link activation'
expect_text "$root/tests/integration/web_browser_startup" '"noopener"' \
	'headless browser probe does not require external links to sever opener authority'
expect_text "$root/tests/integration/web_browser_startup" '--local-application' \
	'headless browser probe cannot launch a visitor-selected WAT from the gallery'
expect_text "$root/test_browser" '--local-application tests/fixtures/animated.wat' \
	'optional browser gate does not prove the gallery local-file delivery path'
expect_text "$root/test_browser" 'demos/ulam-flower.wat' \
	'optional browser gate does not exercise the shipped Ulam external link'
expect_text "$root/tests/integration/web_external_link" '--require-external-link' \
	'direct browser application gate does not require trusted link activation'
expect_text "$root/test_browser" 'run_touch_activation_browser || exit' \
	'optional browser gate does not prove coarse-pointer release slop'
expect_text "$root/test_browser" 'run_compressed_package_browser || exit' \
	'optional browser gate does not prove a compressed .aed runs end to end'
reject_text "$root/packaging/web/local-application.mjs" 'parseAedArchive' \
	'a second JavaScript .aed implementation can diverge from the Rust reader again'
# Two sides of one readiness contract: the launcher declares its change
# listener live, and the gate refuses to inject a file until it has. DOM
# presence alone races module execution and loses roughly one run in five.
expect_text "$root/packaging/web/launcher.mjs" 'picker.dataset.listening = "true"' \
	'gallery launcher never declares its file listener ready'
expect_text "$root/tests/integration/web_browser_startup" '?.dataset.listening === "true"' \
	'browser gate can inject a picked file before the gallery is listening'
expect_text "$root/tests/integration/web_browser_startup" '"--mute-audio"' \
	'headless browser acceptance can emit physical audio during automated tests'
expect_text "$root/tests/integration/web_packaged_audio" 'server_pid=$!' \
	'packaged browser probe does not retain direct ownership of its web server'
reject_text "$root/tests/integration/web_packaged_audio" 'coproc APP' \
	'packaged browser probe can orphan its coprocess server under output capture'
reject_text "$root/test_browser" 'if [[ ! -x $binary ]]' \
	'optional browser gate can execute a stale host binary merely because it exists'
reject_text "$root/test" 'web_packaged_audio' \
	'fast complete suite still launches live Chromium'
expect_text "$root/tests/integration/web_browser_startup" '--static-root serves PATH without isolation headers' \
	'headless browser probe cannot emulate GitHub Pages response headers'
expect_text "$root/tests/integration/web_browser_startup" 'serviceWorkerControlled' \
	'headless browser snapshot does not expose service-worker control'
expect_text "$root/.github/workflows/ci.yml" 'chrome=$(command -v google-chrome)' \
	'GitHub Pages acceptance does not select the runner-provided stable Chrome explicitly'
expect_text "$root/.github/workflows/ci.yml" '--timeout-ms 60000' \
	'GitHub Pages acceptance retains a browser-launch timeout too short for contended hosted runners'
expect_text "$root/test" 'run_web_build() {' \
	'full suite does not capture and classify expected browser compiler diagnostics'
expect_text "$root/test" 'warning: unstable feature specified for `-Ctarget-feature`: `atomics`' \
	'full suite does not explicitly classify the required unstable atomics warning'
expect_text "$root/test" 'cargo --quiet --config web/cargo-config.toml build --lib' \
	'browser library compilation emits dependency progress and compatibility notices in the full suite'
expect_text "$root/test" 'cargo --quiet --config web/cargo-config.toml build --bin aedicule-web' \
	'browser executable compilation emits dependency progress and compatibility notices in the full suite'
test_source=$(sed -n '/testSource = builtins.path {/,/applicationCargoDeps =/p' "$root/flake.nix")
if ! rg -F '"/test"' <<< "$test_source" >/dev/null; then
	printf '%s\n' \
		'sandboxed test source cannot inspect the top-level CI runner for private dependencies' >&2
	failures=$((failures + 1))
fi

quiet_web_shells=$(rg -F 'nix develop .#web --quiet --ignore-environment' "$root/test" | wc -l)
if (( quiet_web_shells != 3 )); then
	printf 'all three nested browser shells must suppress first-fetch Nix progress; found %d\n' \
		"$quiet_web_shells" >&2
	failures=$((failures + 1))
fi

# The device-change event (kind 6) must carry live device-class flags and
# dedupe through the shared tracker, not a hand-rolled size-only key that
# would swallow a pointer-class flip at constant viewport size.
expect_text "$root/src/bin/aedicule-web.rs" 'DeviceChangeTracker' \
	'browser adapter hand-rolls device-change dedupe instead of the shared tracker'
expect_text "$root/src/bin/aedicule-web.rs" 'DEVICE_FLAG_COARSE_POINTER' \
	'browser adapter never sets the coarse-pointer device flag'
reject_text "$root/src/bin/aedicule-web.rs" 'viewport_bits' \
	'browser adapter still keys device-change dedupe on viewport size alone'
# Motion capability: bootstrap captures devicemotion into a bounded ring and
# requests the iOS permission on a user gesture; the adapter drains the ring
# and runs the unit-tested rate limit and shake detection in Rust.
expect_text "$root/web/bootstrap.js" '__AEDICULE_MOTION_SAMPLES' \
	'browser bootstrap never captures devicemotion samples for the adapter'
expect_text "$root/web/bootstrap.js" 'DeviceMotionEvent.requestPermission' \
	'browser bootstrap never requests the iOS motion permission on a gesture'
expect_text "$root/web/bootstrap.js" '__AEDICULE_MOTION_INTEREST' \
	'browser bootstrap requests motion permission without a guest interest'
expect_text "$root/src/bin/aedicule-web.rs" '__AEDICULE_MOTION_SAMPLES' \
	'browser adapter never drains captured devicemotion samples'
expect_text "$root/src/bin/aedicule-web.rs" 'ShakeDetector' \
	'browser adapter does not run the unit-tested shake detector'
expect_text "$root/src/bin/aedicule-web.rs" '__AEDICULE_MOTION_INTEREST' \
	'browser adapter never signals guest motion interest to the page'

exit "$failures"

