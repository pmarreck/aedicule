#!/usr/bin/env bash

set -u

root=$(cd "$(dirname "$0")/../.." && pwd -P)
failures=0

require_file() {
	local path=$1 description=$2
	if [[ ! -s $path ]]; then
		printf 'missing %s: %s\n' "$description" "$path" >&2
		failures=$((failures + 1))
	fi
}

require_text() {
	local path=$1 text=$2 description=$3
	if ! rg -F -- "$text" "$path" >/dev/null 2>&1; then
		printf '%s: %s lacks %s\n' "$description" "$path" "$text" >&2
		failures=$((failures + 1))
	fi
}

reject_text() {
	local path=$1 text=$2 description=$3
	if rg -F -- "$text" "$path" >/dev/null 2>&1; then
		printf '%s: %s still contains %s\n' "$description" "$path" "$text" >&2
		failures=$((failures + 1))
	fi
}

workflow="$root/.github/workflows/ci.yml"
require_file "$workflow" 'CI and GitHub Pages workflow'

if [[ -s $workflow ]]; then
	require_text "$workflow" 'branches: [yolo]' 'Pages workflow trigger'
	require_text "$workflow" 'pages: write' 'Pages deployment permission'
	require_text "$workflow" 'id-token: write' 'Pages identity permission'
	require_text "$workflow" 'nix build .#delivery-web' 'canonical web delivery build'
	require_text "$workflow" '--static-root pages-site/ulam-flower' 'headerless Pages browser gate'
	require_text "$workflow" '--require-controls' 'Ulam Pages control-delivery gate'
	require_text "$workflow" 'actions/configure-pages@v5' 'official Pages configuration action'
	require_text "$workflow" 'actions/upload-pages-artifact@v4' 'official Pages upload action'
	require_text "$workflow" 'actions/deploy-pages@v4' 'official Pages deployment action'
	if ! actionlint "$workflow"; then
		failures=$((failures + 1))
	fi
fi

if [[ -e "$root/web/coi-serviceworker.js" ]]; then
	printf 'obsolete cross-origin-isolation service worker still exists\n' >&2
	failures=$((failures + 1))
fi
reject_text "$root/web/index.html" './coi-serviceworker.js' 'demo isolation bootstrap'
reject_text "$root/packaging/web/index.html" './coi-serviceworker.js' 'gallery isolation bootstrap'
require_file "$root/packaging/web/about.html" 'About Aedicule page'
require_file "$root/packaging/web/abi.html" 'generated Current + Proposed ABI page'
require_text "$root/packaging/web/index.html" './about.html' 'gallery About Aedicule link'
require_text "$root/packaging/web/index.html" './abi.html' 'gallery ABI reference link'
require_text "$root/packaging/web/index.html" 'data-i18n="aboutLink"' \
	'localized gallery About Aedicule link'
require_text "$root/packaging/web/index.html" 'id="local-application-dropzone"' \
	'gallery local application dropzone'
require_text "$root/packaging/web/index.html" 'accept=".wat,.aed"' \
	'gallery local application file picker'
require_text "$root/packaging/web/index.html" 'data-vibesteroids-preview' \
	'Vibesteroids interactive preview'
require_text "$root/packaging/web/index.html" '.card:is(:hover, :focus-visible) .flower::before' \
	'Ulam preview hover/focus animation'
require_text "$root/packaging/web/index.html" '[data-rotation="clockwise"]:is(:hover, :focus-visible) .ship' \
	'Vibesteroids clockwise hover/focus animation'
require_text "$root/packaging/web/index.html" '[data-rotation="counterclockwise"]:is(:hover, :focus-visible) .ship' \
	'Vibesteroids counterclockwise hover/focus animation'
require_text "$root/packaging/web/index.html" '.card:is(:hover, :focus-visible) .spring-mass' \
	'Spring Simulator hover/focus animation trigger'
require_text "$root/packaging/web/index.html" '@keyframes spring-oscillate' \
	'Spring Simulator mass oscillation'
require_text "$root/flake.nix" 'cp ${./packaging/web/local-application.mjs} $out/local-application.mjs' \
	'local application loader delivery'
require_text "$root/flake.nix" 'cp -R ${self.packages.${system}.webRuntime}/. $out/run/' \
	'generic local application runner'
require_text "$root/flake.nix" 'content-address-modules} "$out"' \
	'content-addressed browser module graph'
require_text "$root/flake.nix" 'launcher.mjs launcher-i18n.mjs local-application.mjs' \
	'content-addressed gallery launcher graph'
require_text "$root/flake.nix" 'cp ${./packaging/web/about.html} $out/about.html' \
	'About Aedicule page delivery'
require_text "$root/flake.nix" 'cp ${./packaging/web/abi.html} $out/abi.html' \
	'generated ABI reference page delivery'
require_text "$root/packaging/web/about.html" 'data-i18n="aboutHeadline"' \
	'localized About page headline'
require_text "$root/packaging/web/launcher-i18n.mjs" 'SIX TARGETS. ONE WAT APPLICATION.' \
	'About page six-target headline'
for target in 'Web' 'macOS · ARM64' 'Linux · ARM64' 'Windows · ARM64' \
	'Linux · x86-64' 'Windows · x86-64'; do
	require_text "$root/packaging/web/about.html" "$target" "About page target $target"
done
require_text "$root/packaging/web/launcher-i18n.mjs" 'quadratic and cubic Béziers' \
	'About page current graphics inventory'
require_text "$root/packaging/web/launcher-i18n.mjs" 'packaged FLAC' \
	'About page current audio inventory'
require_text "$root/packaging/web/launcher-i18n.mjs" 'panels, integer sliders, and buttons' \
	'About page current native-control inventory'
require_text "$root/packaging/web/launcher-i18n.mjs" 'not available yet' \
	'About page future/current capability boundary'
require_text "$root/README.md" 'https://pmarreck.github.io/aedicule/' 'public demo link'
require_text "$root/README.md" 'https://pmarreck.github.io/aedicule/ulam-flower/' 'direct Ulam Flower demo link'
require_text "$root/README.md" 'https://pmarreck.github.io/aedicule/vibesteroids/' 'direct Vibesteroids demo link'
require_text "$root/README.md" 'https://pmarreck.github.io/aedicule/spring-sim/' 'direct Spring Simulator demo link'
require_text "$root/packaging/web/index.html" './vibesteroids.aed' 'direct Vibesteroids package download'
require_text "$root/packaging/web/index.html" './spring-sim/' 'Spring Simulator gallery card'
require_text "$root/packaging/web/index.html" './spring_sim.aed' 'direct Spring Simulator package download'
require_text "$root/flake.nix" 'webPackageBundle = { package, assets ? []' \
	'package-backed static web bundle constructor'
require_text "$root/flake.nix" 'package = ./demos/vibesteroids.aed;' \
	'Pages Vibesteroids source package'
require_text "$root/flake.nix" 'package = ./demos/spring_sim.aed;' \
	'Pages Spring Simulator source package'
require_text "$root/flake.nix" '"assets/audio/satellite-destroyed.flac"' \
	'Pages Vibesteroids sampled-audio asset'
require_text "$root/flake.nix" 'application-assets.json' \
	'Pages package asset catalog'
require_text "$root/flake.nix" '"/README.md"' 'README in Nix test source'

exit "$failures"
