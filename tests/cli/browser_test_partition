#!/usr/bin/env bash

set -u

root=$(cd "$(dirname "$0")/../.." && pwd -P)
source "$root/tests/lib/capture.bash"

standard_suite="$root/test"
browser_suite="$root/test_browser"
local_server="$root/serve_web"
flake="$root/flake.nix"
workflow="$root/.github/workflows/ci.yml"
failures=0

require_executable() {
	local path=$1 description=$2
	if [[ ! -x $path ]]; then
		printf '%s is not executable: %s\n' "$description" "$path" >&2
		failures=$((failures + 1))
	fi
}

require_text() {
	local path=$1 needle=$2 description=$3
	if ! rg -F -- "$needle" "$path" >/dev/null 2>&1; then
		printf '%s lacks %s\n' "$description" "$needle" >&2
		failures=$((failures + 1))
	fi
}

reject_text() {
	local path=$1 needle=$2 description=$3
	if rg -F -- "$needle" "$path" >/dev/null 2>&1; then
		printf '%s still contains %s\n' "$description" "$needle" >&2
		failures=$((failures + 1))
	fi
}

require_executable "$browser_suite" 'optional browser integration suite'
require_executable "$local_server" 'local web-delivery server'

reject_text "$standard_suite" 'web_packaged_audio' \
	'fast standard suite'
reject_text "$flake" \
	'tests/integration/web_packaged_audio target/release/aedicule' \
	'isolated standard Nix check'
if [[ $(rg -F -c 'pkgs.chromium' "$flake") != 1 ]]; then
	printf 'Chromium must belong only to one optional browser development shell\n' >&2
	failures=$((failures + 1))
fi
require_text "$flake" 'browser = pkgs.mkShell' \
	'optional browser development shell'
reject_text "$root/tests/cli/development_dependencies" \
	'required+=(chromium)' \
	'fast standard development dependency gate'

require_text "$browser_suite" \
	'./tests/integration/web_packaged_audio' \
	'optional browser integration suite'
require_text "$browser_suite" \
	'./tests/integration/web_standalone_action' \
	'optional browser integration suite'
require_text "$browser_suite" \
	'develop=(nix develop .#browser --ignore-environment --keep HOME)' \
	'optional browser integration suite'
require_text "$browser_suite" \
	'run_parallel_checks prepare_gui_binary prepare_browser_runtime' \
	'optional browser integration suite'
require_text "$browser_suite" \
	'cargo test --no-default-features --features gui-test-support --bin aedicule --test gui_cli' \
	'optional browser integration suite'
require_text "$browser_suite" \
	'nix build .#webRuntime --no-link --print-out-paths' \
	'optional browser integration suite'
require_text "$root/tests/integration/web_packaged_audio" \
	'--timeout-ms 60000' \
	'optional packaged browser probe'

if [[ $(rg -F -c './tests/integration/web_browser_startup \' "$workflow") != 1 ]]; then
	printf 'regular CI must launch exactly one browser in its web-delivery lane\n' >&2
	failures=$((failures + 1))
fi

require_text "$local_server" \
	'nix build .#delivery-web --no-link --print-out-paths' \
	'local web-delivery server'
require_text "$local_server" \
	'nix run .#webServe -- "$webroot"' \
	'local web-delivery server'
require_text "$local_server" \
	'AEDICULE_WEB_DISPLAY=http://127.0.0.1:8910' \
	'local web-delivery server'
require_text "$local_server" \
	'AEDICULE_WEB_BIND=127.0.0.1' \
	'local web-delivery server'
require_text "$local_server" \
	'AEDICULE_WEB_LISTEN=http://:8910' \
	'local web-delivery server'

out= err= rc=0
capture "$browser_suite" --help
if (( rc != 0 )) || [[ $out != *'usage: ./test_browser'* ]] || [[ -n $err ]]; then
	printf 'optional browser integration help is not clean and current\n' >&2
	failures=$((failures + 1))
fi

out= err= rc=0
capture "$local_server" --help
if (( rc != 0 )) ||
	[[ $out != *'usage: ./serve_web'* ]] ||
	[[ $out != *'Default: http://127.0.0.1:8910/'* ]] ||
	[[ -n $err ]]; then
	printf 'local web-delivery help is not clean and current\n' >&2
	failures=$((failures + 1))
fi

out= err= rc=0
capture "$local_server" --unknown
if (( rc != 2 )) || [[ -n $out ]] || [[ $err != *'unknown argument'* ]]; then
	printf 'local web-delivery server does not reject unknown arguments cleanly\n' >&2
	failures=$((failures + 1))
fi

out= err= rc=0
capture "$local_server" --listen not-an-address
if (( rc != 2 )) || [[ -n $out ]] || [[ $err != *'invalid listen address'* ]]; then
	printf 'local web-delivery server does not reject invalid listen addresses cleanly\n' >&2
	failures=$((failures + 1))
fi

exit "$failures"
