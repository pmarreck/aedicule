const HELP = `usage: web_browser_startup [--chrome PATH] [--timeout-ms N] [--require-audio-playback] [--require-key-delivery] [--require-controls] [--require-external-link] URL
       web_browser_startup [--chrome PATH] [--timeout-ms N] [--require-audio-playback] [--require-key-delivery] [--require-controls] [--require-external-link] [--local-application PATH] --static-root PATH

Launch a headless Chromium browser, stream Aedicule's structured startup
timeline, and reject browser exceptions or a missing/1x1 GPUI canvas.

--static-root serves PATH without isolation headers, matching GitHub Pages.
--require-audio-playback requires activation, running context, non-zero PCM,
source start, and source completion through the Web Audio adapter.
--require-key-delivery rejects a static guest unless W/A/D down/up edges all
cross the browser-to-WAT boundary and produce one committed frame change.
--require-controls requires AVP buttons/sliders and proves their events reach the guest.
--require-external-link clicks an AVP link and requires transient activation,
the normalized destination, _blank, and noopener without opening a real popup.
--local-application selects a .wat or .aed through the gallery and requires the
generic origin-local runner to reach the same settled application state.

Environment:
  AEDICULE_CHROME               Chromium-family executable (overridden by --chrome)
  AEDICULE_BROWSER_TRACE_EVENTS Set to 1 for each injected/observed input event
`;

function parseArguments(arguments_) {
	let chrome;
	let timeoutMs = 15_000;
	let requireAudioPlayback = false;
	let requireControls = false;
	let requireExternalLink = false;
	let requireKeyDelivery = false;
	let localApplication;
	let staticRoot;
	let url;
	for (let index = 0; index < arguments_.length; index += 1) {
		const argument = arguments_[index];
		if (argument === "-h" || argument === "--help") {
			process.stdout.write(HELP);
			process.exit(0);
		}
		if (argument === "--about") {
			process.stdout.write("Aedicule headless browser startup diagnostic 0.1.0\n");
			process.exit(0);
		}
		if (argument === "--chrome") {
			chrome = arguments_[index += 1];
			continue;
		}
		if (argument === "--timeout-ms") {
			timeoutMs = Number(arguments_[index += 1]);
			continue;
		}
		if (argument === "--static-root") {
			staticRoot = arguments_[index += 1];
			continue;
		}
		if (argument === "--local-application") {
			localApplication = resolve(arguments_[index += 1]);
			continue;
		}
		if (argument === "--require-audio-playback") {
			requireAudioPlayback = true;
			continue;
		}
		if (argument === "--require-controls") {
			requireControls = true;
			continue;
		}
		if (argument === "--require-external-link") {
			requireExternalLink = true;
			continue;
		}
		if (argument === "--require-key-delivery") {
			requireKeyDelivery = true;
			continue;
		}
		if (argument.startsWith("-")) {
			throw new Error(`unknown option: ${argument}`);
		}
		if (url !== undefined) {
			throw new Error("exactly one URL is required");
		}
		url = argument;
	}
	if (!Number.isSafeInteger(timeoutMs) || timeoutMs <= 0) {
		throw new Error("--timeout-ms must be a positive integer");
	}
	if ((url === undefined) === (staticRoot === undefined)) {
		throw new Error("exactly one URL or --static-root PATH is required");
	}
	if (localApplication !== undefined) {
		if (staticRoot === undefined) {
			throw new Error("--local-application requires --static-root");
		}
		if (![".wat", ".aed"].includes(extname(localApplication).toLowerCase())) {
			throw new Error("--local-application requires a .wat or .aed path");
		}
		if (!existsSync(localApplication)) {
			throw new Error(`local application does not exist: ${localApplication}`);
		}
	}
	return {
		chrome,
		localApplication,
		requireAudioPlayback,
		requireControls,
		requireExternalLink,
		requireKeyDelivery,
		staticRoot,
		timeoutMs,
		url: url === undefined ? undefined : new URL(url).href,
	};
}

async function waitForGalleryReady(protocol, timeoutMs) {
	await withTimeout(new Promise((resolveReady, rejectReady) => {
		let finished = false;
		let checking = false;
		let pendingCheck = false;
		const finish = error => {
			if (finished) return;
			finished = true;
			removeListener();
			if (error === undefined) resolveReady();
			else rejectReady(error);
		};
		const check = async () => {
			if (finished) return;
			if (checking) {
				pendingCheck = true;
				return;
			}
			checking = true;
			try {
				const result = await protocol.send("Runtime.evaluate", {
					expression: `globalThis.crossOriginIsolated === true
						&& document.getElementById("local-application-picker") !== null`,
					returnByValue: true,
				});
				if (result.result.value === true) finish();
			} catch {
				// A headerless host intentionally replaces the first execution
				// context while its isolation service worker takes control.
			} finally {
				checking = false;
				if (pendingCheck && !finished) {
					pendingCheck = false;
					check();
				}
			}
		};
		const removeListener = protocol.onEvent(message => {
			if (message.method === "Page.loadEventFired"
				|| message.method === "Page.frameNavigated") {
				check();
			}
		});
		check().catch(finish);
	}), timeoutMs, "isolated Aedicule gallery file picker");
}

async function selectLocalApplication(protocol, path, timeoutMs) {
	await waitForGalleryReady(protocol, timeoutMs);
	const bytes = readFileSync(path).toString("base64");
	const name = path.split(sep).at(-1);
	const result = await protocol.send("Runtime.evaluate", {
		expression: `(async () => {
			const encoded = ${JSON.stringify(bytes)};
			const binary = atob(encoded);
			const bytes = Uint8Array.from(binary, character => character.charCodeAt(0));
			const file = new File([bytes], ${JSON.stringify(name)});
			const transfer = new DataTransfer();
			transfer.items.add(file);
			const picker = document.getElementById("local-application-picker");
			Object.defineProperty(picker, "files", {
				configurable: true,
				value: transfer.files,
			});
			picker.dispatchEvent(new Event("change", { bubbles: true }));
			return true;
		})()`,
		awaitPromise: true,
		returnByValue: true,
	});
	if (result.result.value !== true) throw new Error("could not select local application");
}

const contentTypes = Object.freeze({
	".html": "text/html; charset=utf-8",
	".js": "text/javascript; charset=utf-8",
	".json": "application/json; charset=utf-8",
	".mjs": "text/javascript; charset=utf-8",
	".png": "image/png",
	".wasm": "application/wasm",
	".wat": "text/plain; charset=utf-8",
});

/**
 * Classifies the complete Web Audio lifecycle as a set of independently
 * falsifiable boundary failures rather than trusting a request counter.
 */
export function audioPlaybackFailures(timeline) {
	const failures = [];
	if (!timeline.some(entry =>
		entry.stage === "unlock-event" && entry.userActivationSeen === true)) {
		failures.push("Web Audio observed no user activation");
	}
	if (!timeline.some(entry =>
		["context-created", "context-resumed"].includes(entry.stage)
		&& entry.contextState === "running")) {
		failures.push("Web Audio observed no running context");
	}
	if (!timeline.some(entry =>
		entry.stage === "pcm-admitted"
		&& entry.nonzeroSamples > 0
		&& entry.peak > 0
		&& entry.rootMeanSquare > 0)) {
		failures.push("Web Audio admitted no non-zero PCM");
	}
	if (!timeline.some(entry =>
		entry.stage === "source-started" && entry.contextState === "running")) {
		failures.push("Web Audio observed no source start in a running context");
	}
	if (!timeline.some(entry => entry.stage === "source-ended")) {
		failures.push("Web Audio observed no source completion");
	}
	return failures;
}

/**
 * Serves a bundle with ordinary static-host headers so the browser probe
 * independently verifies Aedicule's GitHub Pages isolation adapter.
 */
async function startStaticServer(root) {
	const absoluteRoot = resolve(root);
	const server = createServer(async (request, response) => {
		try {
			const url = new URL(request.url ?? "/", "http://127.0.0.1");
			const relative = decodeURIComponent(url.pathname).replace(/^\/+/, "");
			const path = resolve(absoluteRoot, relative.endsWith("/") || relative === "" ? `${relative}index.html` : relative);
			if (path !== absoluteRoot && !path.startsWith(`${absoluteRoot}${sep}`)) {
				response.writeHead(403).end();
				return;
			}
			const body = await readFile(path);
			response.writeHead(200, {
				"Cache-Control": "no-store",
				"Content-Type": contentTypes[extname(path)] ?? "application/octet-stream",
			});
			response.end(body);
		} catch (error) {
			const status = error?.code === "ENOENT" ? 404 : 500;
			response.writeHead(status, { "Content-Type": "text/plain; charset=utf-8" });
			response.end(status === 404 ? "Not found\n" : "Static server failure\n");
		}
	});
	await new Promise((accept, reject) => {
		server.once("error", reject);
		server.listen(0, "127.0.0.1", accept);
	});
	const address = server.address();
	return {
		close: () => new Promise((accept, reject) => server.close(error => error ? reject(error) : accept())),
		url: `http://127.0.0.1:${address.port}/`,
	};
}

function executableOnPath(name) {
	for (const directory of (process.env.PATH ?? "").split(delimiter)) {
		const candidate = join(directory, name);
		try {
			accessSync(candidate, constants.X_OK);
			return candidate;
		} catch {
			// Try the next PATH entry.
		}
	}
	return undefined;
}

function resolveChrome(explicit) {
	const candidates = [
		explicit,
		process.env.AEDICULE_CHROME,
		executableOnPath("chromium"),
		executableOnPath("chromium-browser"),
		executableOnPath("google-chrome"),
		"/Applications/Google Chrome.app/Contents/MacOS/Google Chrome",
	];
	const chrome = candidates.find(candidate => candidate && existsSync(candidate));
	if (chrome === undefined) {
		throw new Error("no Chromium executable found; set AEDICULE_CHROME or use --chrome");
	}
	return chrome;
}

/**
 * Gives headless Chrome a disposable writable home and removes Nix's disabled
 * D-Bus sentinel so profile helpers can initialize inside a build sandbox.
 */
export function browserProcessEnvironment(profile, environment = process.env) {
	const browserEnvironment = {
		...environment,
		HOME: profile,
		XDG_CACHE_HOME: environment.XDG_CACHE_HOME || join(profile, "cache"),
		XDG_CONFIG_HOME: environment.XDG_CONFIG_HOME || join(profile, "config"),
	};
	if (["", "disabled:"].includes(browserEnvironment.DBUS_SESSION_BUS_ADDRESS)) {
		delete browserEnvironment.DBUS_SESSION_BUS_ADDRESS;
	}
	return browserEnvironment;
}

function withTimeout(promise, timeoutMs, description) {
	return new Promise((resolve, reject) => {
		const timer = setTimeout(() => reject(new Error(`timed out waiting for ${description}`)), timeoutMs);
		promise.then(
			value => {
				clearTimeout(timer);
				resolve(value);
			},
			error => {
				clearTimeout(timer);
				reject(error);
			},
		);
	});
}

export async function waitForFile(path, timeoutMs, adapters = {}) {
	const cancel = adapters.cancel ?? clearTimeout;
	const exists = adapters.exists ?? existsSync;
	const schedule = adapters.schedule ?? setTimeout;
	const watchDirectory = adapters.watch ?? watch;
	if (exists(path)) return;
	await new Promise((resolve, reject) => {
		let settled = false;
		let timer;
		let watcher;
		const finish = error => {
			if (settled) return;
			settled = true;
			if (timer !== undefined) cancel(timer);
			watcher?.close();
			if (error === undefined) resolve();
			else reject(error);
		};
		try {
			watcher = watchDirectory(join(path, ".."), (event, filename) => {
				if (filename === "DevToolsActivePort" && exists(path)) finish();
			});
			watcher.on("error", finish);
			timer = schedule(
				() => finish(new Error("timed out waiting for Chrome's DevTools endpoint")),
				timeoutMs,
			);
			if (exists(path)) finish();
		} catch (error) {
			finish(error);
		}
	});
}

/**
 * Polls Chrome's target list because DevToolsActivePort can become visible
 * before the initial page target on busy or virtualized CI machines.
 */
export async function waitForDebuggablePage(port, timeoutMs, adapters = {}) {
	const listPages = adapters.listPages ?? (async url => (await (await fetch(url)).json()));
	const retry = adapters.retry ?? (() => new Promise(resolveRetry => setTimeout(resolveRetry, 25)));
	const deadline = Date.now() + timeoutMs;
	do {
		try {
			const pages = await listPages(`http://127.0.0.1:${port}/json/list`);
			const page = pages.find(candidate =>
				candidate.type === "page" && typeof candidate.webSocketDebuggerUrl === "string");
			if (page !== undefined) return page;
		} catch {
			// The target endpoint itself can briefly trail DevToolsActivePort.
		}
		await retry();
	} while (Date.now() < deadline);
	throw new Error("Chrome exposed no debuggable page");
}

async function connect(url, timeoutMs) {
	return withTimeout(new Promise((resolve, reject) => {
		const socket = new WebSocket(url);
		socket.addEventListener("open", () => resolve(socket), { once: true });
		socket.addEventListener("error", () => reject(new Error("Chrome DevTools WebSocket failed")), { once: true });
	}), timeoutMs, "Chrome's DevTools WebSocket");
}

function remoteValue(argument) {
	if (Object.hasOwn(argument, "value")) return argument.value;
	return argument.unserializableValue ?? argument.description ?? argument.type;
}

function createProtocol(socket) {
	let nextId = 1;
	const pending = new Map();
	const listeners = new Set();
	socket.addEventListener("message", event => {
		const message = JSON.parse(event.data);
		if (message.id !== undefined) {
			const operation = pending.get(message.id);
			pending.delete(message.id);
			if (message.error) operation.reject(new Error(message.error.message));
			else operation.resolve(message.result);
			return;
		}
		for (const listener of listeners) listener(message);
	});
	return {
		onEvent(listener) {
			listeners.add(listener);
			return () => listeners.delete(listener);
		},
		send(method, params = {}) {
			const id = nextId++;
			return new Promise((resolve, reject) => {
				pending.set(id, { resolve, reject });
				socket.send(JSON.stringify({ id, method, params }));
			});
		},
	};
}

export function inputObserverSource(verboseEvents, interceptExternalLinks = false) {
	return `(() => {
		globalThis.__AEDICULE_TRACE_EVENTS = ${verboseEvents};
		const probe = { counts: {}, events: [], hiddenInputFocusRequests: 0, openRequests: [] };
		globalThis.__AEDICULE_INPUT_PROBE = probe;
		if (${interceptExternalLinks}) {
			globalThis.open = function(url, target, features) {
				probe.openRequests.push({
					url: String(url),
					target: String(target),
					features: String(features),
					userActivation: navigator.userActivation?.isActive === true,
				});
				return Object.create(null);
			};
		}
		const originalInputFocus = HTMLInputElement.prototype.focus;
		HTMLInputElement.prototype.focus = function(...arguments_) {
			probe.hiddenInputFocusRequests += 1;
			return originalInputFocus.apply(this, arguments_);
		};
		for (const type of [
			"mousemove", "mousedown", "mouseup", "wheel", "keydown", "keyup",
			"pointerdown", "pointermove", "pointerup", "pointercancel",
			"touchstart", "touchmove", "touchend", "touchcancel",
		]) {
			addEventListener(type, event => {
				probe.counts[type] = (probe.counts[type] ?? 0) + 1;
				const detail = {
					type,
					x: event.clientX ?? null,
					y: event.clientY ?? null,
					button: event.button ?? null,
					buttons: event.buttons ?? null,
					deltaX: event.deltaX ?? null,
					deltaY: event.deltaY ?? null,
					code: event.code ?? null,
					key: event.key ?? null,
					pointerId: event.pointerId ?? null,
					pointerType: event.pointerType ?? null,
					isPrimary: event.isPrimary ?? null,
					touches: event.touches?.length ?? null,
					changedTouches: event.changedTouches?.length ?? null,
				};
				probe.events.push(detail);
				if (globalThis.__AEDICULE_TRACE_EVENTS) {
					console.info("[Aedicule input]", "dom", JSON.stringify(detail));
				}
			}, true);
		}
	})()`;
}

async function pageSnapshot(protocol) {
	const evaluation = await protocol.send("Runtime.evaluate", {
		expression: `(() => ({
			readyState: document.readyState,
			crossOriginIsolated: globalThis.crossOriginIsolated === true,
			serviceWorkerControlled: navigator.serviceWorker?.controller !== null,
			status: document.getElementById("aedicule-startup-status")?.textContent ?? null,
			audioRequestCount: globalThis.__AEDICULE_AUDIO_REQUEST_COUNT ?? 0,
			audioDiagnostic: globalThis.__AEDICULE_AUDIO_DIAGNOSTIC ?? null,
			deliveredEventCount: globalThis.__AEDICULE_DELIVERED_EVENT_COUNT ?? 0,
			deliveredEventCounts: globalThis.__AEDICULE_DELIVERED_EVENT_COUNTS
				?? { total: 0, controls: 0, menuActions: 0, pointer: 0 },
			frameBackground: globalThis.__AEDICULE_FRAME_BACKGROUND ?? null,
			runtime: globalThis.__AEDICULE_RUNTIME_DIAGNOSTIC ?? null,
			ui: globalThis.__AEDICULE_UI_SNAPSHOT ?? null,
			externalLinkActivation: globalThis.__AEDICULE_EXTERNAL_LINK_ACTIVATION ?? null,
			openRequests: globalThis.__AEDICULE_INPUT_PROBE?.openRequests ?? [],
			canvases: Array.from(document.querySelectorAll("canvas"), canvas => {
				const bounds = canvas.getBoundingClientRect();
				return { bufferWidth: canvas.width, bufferHeight: canvas.height,
					cssWidth: bounds.width, cssHeight: bounds.height };
			}),
		}))()`,
		returnByValue: true,
	});
	return evaluation.result.value;
}

async function screenshotDigest(protocol) {
	const screenshot = await protocol.send("Page.captureScreenshot", {
		format: "png",
		fromSurface: true,
	});
	return createHash("sha256").update(screenshot.data, "base64").digest("hex");
}

/**
 * Chooses a deterministic canvas probe point outside AVP control rectangles so
 * an input-routing test cannot mistake intentional UI occlusion for lost guest input.
 */
export function chooseCanvasInputPoint(canvas, ui = {}) {
	const rectangles = ["panels", "buttons", "sliders", "externalLinks"]
		.flatMap(kind => ui?.[kind] ?? []);
	const pointIsFree = ({ x, y }) => !rectangles.some(rectangle => (
		x >= rectangle.x
		&& x < rectangle.x + rectangle.width
		&& y >= rectangle.y
		&& y < rectangle.y + rectangle.height
	));
	const xs = [0.5, 0.25, 0.75].map(fraction => (
		Math.max(1, Math.floor(canvas.cssWidth * fraction))
	));
	const ys = [0.25, 0.5, 0.75].map(fraction => (
		Math.max(81, Math.floor(canvas.cssHeight * fraction))
	));
	for (const y of ys) {
		for (const x of xs) {
			const point = { x, y };
			if (pointIsFree(point)) return point;
		}
	}
	return { x: xs[0], y: ys[0] };
}

/**
 * Waits for guest semantic counters to remain unchanged across animation
 * frames, separating prior canvas input from a later control-occlusion proof.
 */
export async function waitForSemanticInputQuiescence(
	protocol,
	{ maxFrames = 60, stableFrames = 2 } = {},
) {
	let previous;
	let stable = 0;
	for (let frame = 0; frame < maxFrames; frame += 1) {
		const result = await protocol.send("Runtime.evaluate", {
			expression: `(async () => {
				await new Promise(resolve => requestAnimationFrame(resolve));
				return globalThis.__AEDICULE_DELIVERED_EVENT_COUNTS ?? {};
			})()`,
			awaitPromise: true,
			returnByValue: true,
		});
		const current = JSON.stringify(result.result.value ?? {});
		if (current === previous) {
			stable += 1;
			if (stable >= stableFrames) return true;
		} else {
			stable = 0;
			previous = current;
		}
	}
	return false;
}

async function synthesizeInput(protocol, snapshot, verboseEvents) {
	const canvas = snapshot.canvases[0];
	if (canvas === undefined) {
		return { dispatched: 0, observed: {}, visualChanged: false };
	}
	const { x, y } = chooseCanvasInputPoint(canvas, snapshot.ui);
	const chordEvents = [
		["secondary-down", { type: "mousePressed", x, y, button: "right", buttons: 2, clickCount: 1 }],
		["primary-down-while-secondary-held", { type: "mousePressed", x, y, button: "left", buttons: 3, clickCount: 1 }],
		["secondary-up-while-primary-held", { type: "mouseReleased", x, y, button: "right", buttons: 1, clickCount: 1 }],
	];
	const events = [
		["pointer-move", "Input.dispatchMouseEvent", { type: "mouseMoved", x, y, button: "none", buttons: 0 }],
		["primary-down", "Input.dispatchMouseEvent", { type: "mousePressed", x, y, button: "left", buttons: 1, clickCount: 1 }],
		["primary-up", "Input.dispatchMouseEvent", { type: "mouseReleased", x, y, button: "left", buttons: 0, clickCount: 1 }],
		["middle-down", "Input.dispatchMouseEvent", { type: "mousePressed", x, y, button: "middle", buttons: 4, clickCount: 1 }],
		["middle-up", "Input.dispatchMouseEvent", { type: "mouseReleased", x, y, button: "middle", buttons: 0, clickCount: 1 }],
		["secondary-down", "Input.dispatchMouseEvent", { type: "mousePressed", x, y, button: "right", buttons: 2, clickCount: 1 }],
		["secondary-up", "Input.dispatchMouseEvent", { type: "mouseReleased", x, y, button: "right", buttons: 0, clickCount: 1 }],
		["two-axis-wheel", "Input.dispatchMouseEvent", { type: "mouseWheel", x, y, deltaX: 12.5, deltaY: -24.5 }],
	];
	const keyEvents = [
		["arrow-left-down", "Input.dispatchKeyEvent", { type: "rawKeyDown", code: "ArrowLeft", key: "ArrowLeft", windowsVirtualKeyCode: 37, nativeVirtualKeyCode: 37 }],
		["arrow-left-up", "Input.dispatchKeyEvent", { type: "keyUp", code: "ArrowLeft", key: "ArrowLeft", windowsVirtualKeyCode: 37, nativeVirtualKeyCode: 37 }],
		["w-down", "Input.dispatchKeyEvent", { type: "rawKeyDown", code: "KeyW", key: "w", windowsVirtualKeyCode: 87, nativeVirtualKeyCode: 87 }],
		["w-up", "Input.dispatchKeyEvent", { type: "keyUp", code: "KeyW", key: "w", windowsVirtualKeyCode: 87, nativeVirtualKeyCode: 87 }],
		["a-down", "Input.dispatchKeyEvent", { type: "rawKeyDown", code: "KeyA", key: "a", windowsVirtualKeyCode: 65, nativeVirtualKeyCode: 65 }],
		["a-up", "Input.dispatchKeyEvent", { type: "keyUp", code: "KeyA", key: "a", windowsVirtualKeyCode: 65, nativeVirtualKeyCode: 65 }],
		["d-down", "Input.dispatchKeyEvent", { type: "rawKeyDown", code: "KeyD", key: "d", windowsVirtualKeyCode: 68, nativeVirtualKeyCode: 68 }],
		["d-up", "Input.dispatchKeyEvent", { type: "keyUp", code: "KeyD", key: "d", windowsVirtualKeyCode: 68, nativeVirtualKeyCode: 68 }],
	];
	const touchPoint = (id, pointX, pointY) => ({
		id,
		x: pointX,
		y: pointY,
		radiusX: 8,
		radiusY: 8,
		force: 1,
	});
	const leftX = Math.max(1, Math.floor(canvas.cssWidth * 0.25));
	const rightX = Math.max(1, Math.floor(canvas.cssWidth * 0.75));
	const startY = Math.max(81, Math.floor(canvas.cssHeight * 0.5));
	const touchEvents = [
		["two-finger-start", "Input.dispatchTouchEvent", {
			type: "touchStart",
			touchPoints: [touchPoint(41, leftX, startY), touchPoint(42, rightX, startY)],
		}],
		["left-up-right-down", "Input.dispatchTouchEvent", {
			type: "touchMove",
			touchPoints: [touchPoint(41, leftX, startY - 80), touchPoint(42, rightX, startY + 80)],
		}],
		["two-finger-end", "Input.dispatchTouchEvent", { type: "touchEnd", touchPoints: [] }],
		["cancelled-contact-start", "Input.dispatchTouchEvent", {
			type: "touchStart",
			touchPoints: [touchPoint(43, x, y)],
		}],
		["cancelled-contact-end", "Input.dispatchTouchEvent", { type: "touchCancel", touchPoints: [] }],
	];

	const before = await screenshotDigest(protocol);
	await protocol.send("Runtime.evaluate", {
		expression: `document.body.tabIndex = -1; document.body.focus()`,
	});
	const focusRequestsBeforeInput = (await protocol.send("Runtime.evaluate", {
		expression: "globalThis.__AEDICULE_INPUT_PROBE?.hiddenInputFocusRequests ?? 0",
		returnByValue: true,
	})).result.value ?? 0;
	const pointerCountBeforeChord = (await pageSnapshot(protocol)).deliveredEventCounts.pointer;
	for (const [name, params] of chordEvents) {
		if (verboseEvents) {
			process.stdout.write(`${JSON.stringify({
				type: "input-dispatch",
				name,
				method: "Input.dispatchMouseEvent",
				params,
			})}\n`);
		}
		await protocol.send("Input.dispatchMouseEvent", params);
	}
	const chordDelivered = await waitForSemanticCount(
		protocol,
		"pointer",
		pointerCountBeforeChord + chordEvents.length,
	);
	const chordPointerDelta = (await pageSnapshot(protocol)).deliveredEventCounts.pointer
		- pointerCountBeforeChord;
	await protocol.send("Input.dispatchMouseEvent", {
		type: "mouseReleased", x, y, button: "left", buttons: 0, clickCount: 1,
	});
	for (const [name, method, params] of events) {
		if (verboseEvents) {
			process.stdout.write(`${JSON.stringify({ type: "input-dispatch", name, method, params })}\n`);
		}
		await protocol.send(method, params);
	}
	const focusRequestsBeforeTouch = (await protocol.send("Runtime.evaluate", {
		expression: "globalThis.__AEDICULE_INPUT_PROBE?.hiddenInputFocusRequests ?? 0",
		returnByValue: true,
	})).result.value ?? 0;
	await protocol.send("Emulation.setTouchEmulationEnabled", { enabled: true, maxTouchPoints: 3 });
	for (const [name, method, params] of touchEvents) {
		if (verboseEvents) {
			process.stdout.write(`${JSON.stringify({ type: "input-dispatch", name, method, params })}\n`);
		}
		await protocol.send(method, params);
	}
	const focusRequestsAfterTouch = (await protocol.send("Runtime.evaluate", {
		expression: "globalThis.__AEDICULE_INPUT_PROBE?.hiddenInputFocusRequests ?? 0",
		returnByValue: true,
	})).result.value ?? 0;
	await protocol.send("Runtime.evaluate", {
		expression: "new Promise(resolve => requestAnimationFrame(() => requestAnimationFrame(resolve)))",
		awaitPromise: true,
	});
	const beforeKey = await pageSnapshot(protocol);
	for (const [name, method, params] of keyEvents) {
		if (verboseEvents) {
			process.stdout.write(`${JSON.stringify({ type: "input-dispatch", name, method, params })}\n`);
		}
		await protocol.send(method, params);
	}
	const inputQuiesced = await waitForSemanticInputQuiescence(protocol);
	const after = await screenshotDigest(protocol);
	const afterKey = await pageSnapshot(protocol);
	const probe = await protocol.send("Runtime.evaluate", {
		expression: "globalThis.__AEDICULE_INPUT_PROBE",
		returnByValue: true,
	});
	const probeValue = probe.result.value ?? { counts: {}, events: [] };
	const observed = probeValue.counts;
	const focusRequestsAfterInput = probeValue.hiddenInputFocusRequests ?? 0;
	const observedMousePointerEvents = probeValue.events.filter(event => event.pointerType === "mouse");
	const mousePointerPhases = Object.fromEntries(
		["pointerdown", "pointerup"].map(type => [
			type,
			observedMousePointerEvents.filter(event => event.type === type).length,
		]),
	);
	const observedTouchEvents = probeValue.events.filter(event => event.pointerType === "touch");
	const touchContacts = [...new Set(observedTouchEvents.map(event => event.pointerId))].sort((left, right) => left - right);
	const touchPhases = Object.fromEntries(
		["pointerdown", "pointermove", "pointerup", "pointercancel"].map(type => [
			type,
			observedTouchEvents.filter(event => event.type === type).length,
		]),
	);
	return {
		chordDelivered,
		chordPointerDelta,
		dispatched: chordEvents.length + 1 + events.length + keyEvents.length + touchEvents.length,
		inputQuiesced,
		keyFrameChanged: beforeKey.frameBackground !== afterKey.frameBackground,
		observed,
		mousePointerPhases,
		hiddenInputTouchFocusRequests: focusRequestsAfterTouch - focusRequestsBeforeTouch,
		hiddenInputFocusRequestsBeforeInput: focusRequestsBeforeInput,
		hiddenInputFocusRequestsBeforeTouch: focusRequestsBeforeTouch,
		hiddenInputFocusRequestsAfterTouch: focusRequestsAfterTouch,
		hiddenInputFocusRequestsAfterInput: focusRequestsAfterInput,
		touchContacts,
		touchPhases,
		visualChanged: before !== after,
	};
}

async function waitForSemanticCount(protocol, field, expectedCount) {
	const result = await protocol.send("Runtime.evaluate", {
		expression: `(async () => {
			for (let frame = 0; frame < 30; frame += 1) {
				const counts = globalThis.__AEDICULE_DELIVERED_EVENT_COUNTS;
				if ((counts?.[${JSON.stringify(field)}] ?? 0) >= ${expectedCount}) return true;
				await new Promise(resolve => requestAnimationFrame(resolve));
			}
			return false;
		})()`,
		awaitPromise: true,
		returnByValue: true,
	});
	return result.result.value === true;
}

async function waitForSemanticEvent(protocol, field, priorCount) {
	const result = await protocol.send("Runtime.evaluate", {
		expression: `(async () => {
			for (let frame = 0; frame < 30; frame += 1) {
				const counts = globalThis.__AEDICULE_DELIVERED_EVENT_COUNTS;
				if ((counts?.[${JSON.stringify(field)}] ?? 0) > ${priorCount}) return true;
				await new Promise(resolve => requestAnimationFrame(resolve));
			}
			return false;
		})()`,
		awaitPromise: true,
		returnByValue: true,
	});
	return result.result.value === true;
}

async function waitForAudioPlayback(protocol) {
	const result = await protocol.send("Runtime.evaluate", {
		expression: `(async () => {
			for (let frame = 0; frame < 300; frame += 1) {
				const timeline = globalThis.__AEDICULE_AUDIO_DIAGNOSTIC?.timeline ?? [];
				if (timeline.some(entry => entry.stage === "source-ended")) return true;
				await new Promise(resolve => requestAnimationFrame(resolve));
			}
			return false;
		})()`,
		awaitPromise: true,
		returnByValue: true,
	});
	return result.result.value === true;
}

async function dispatchControlClick(protocol, bounds) {
	const x = Math.round(bounds.x + bounds.width / 2);
	const y = Math.round(bounds.y + bounds.height / 2);
	await protocol.send("Input.dispatchMouseEvent", {
		type: "mouseMoved", x, y, button: "none", buttons: 0,
	});
	await protocol.send("Input.dispatchMouseEvent", {
		type: "mousePressed", x, y, button: "left", buttons: 1, clickCount: 1,
	});
	await protocol.send("Input.dispatchMouseEvent", {
		type: "mouseReleased", x, y, button: "left", buttons: 0, clickCount: 1,
	});
}

async function dispatchSliderDrag(protocol, bounds) {
	const startX = Math.round(bounds.x + bounds.width * 0.25);
	const endX = Math.round(bounds.x + bounds.width * 0.75);
	const y = Math.round(bounds.y + bounds.height * 0.8);
	await protocol.send("Input.dispatchMouseEvent", {
		type: "mouseMoved", x: startX, y, button: "none", buttons: 0,
	});
	await protocol.send("Input.dispatchMouseEvent", {
		type: "mousePressed", x: startX, y, button: "left", buttons: 1, clickCount: 1,
	});
	await protocol.send("Input.dispatchMouseEvent", {
		type: "mouseMoved", x: endX, y, button: "left", buttons: 1,
	});
	await protocol.send("Input.dispatchMouseEvent", {
		type: "mouseReleased", x: endX, y, button: "left", buttons: 0, clickCount: 1,
	});
}

async function exerciseControls(protocol, snapshot) {
	const button = snapshot.ui?.buttons?.[0];
	const slider = snapshot.ui?.sliders?.[0];
	if (button === undefined || slider === undefined) {
		return {
			buttonDelivered: false,
			buttons: snapshot.ui?.buttons?.length ?? 0,
			pointerLeaked: false,
			sliderDelivered: false,
			sliders: snapshot.ui?.sliders?.length ?? 0,
		};
	}

	const beforeButton = snapshot.deliveredEventCounts;
	await dispatchControlClick(protocol, button);
	const buttonDelivered = await waitForSemanticEvent(
		protocol, "menuActions", beforeButton.menuActions,
	);
	const afterButton = await pageSnapshot(protocol);
	const buttonPointerLeaked =
		afterButton.deliveredEventCounts.pointer !== beforeButton.pointer;

	await dispatchSliderDrag(protocol, slider);
	const sliderDelivered = await waitForSemanticEvent(
		protocol, "controls", afterButton.deliveredEventCounts.controls,
	);
	const afterSlider = await pageSnapshot(protocol);
	const sliderPointerLeaked =
		afterSlider.deliveredEventCounts.pointer !== afterButton.deliveredEventCounts.pointer;

	return {
		buttonDelivered,
		buttons: snapshot.ui.buttons.length,
		pointerLeaked: buttonPointerLeaked || sliderPointerLeaked,
		sliderDelivered,
		sliders: snapshot.ui.sliders.length,
	};
}

async function exerciseExternalLink(protocol, snapshot) {
	const link = snapshot.ui?.externalLinks?.[0];
	if (link === undefined) {
		return {
			activated: false,
			externalLinks: 0,
			pointerLeaked: false,
			request: null,
		};
	}
	const pointerCount = snapshot.deliveredEventCounts.pointer;
	await dispatchControlClick(protocol, link);
	await protocol.send("Runtime.evaluate", {
		expression: "new Promise(resolve => requestAnimationFrame(resolve))",
		awaitPromise: true,
	});
	const after = await pageSnapshot(protocol);
	const request = after.openRequests.at(-1) ?? null;
	const diagnostic = after.externalLinkActivation;
	return {
		activated: diagnostic?.status === "opened"
			&& diagnostic?.userActivation === true
			&& diagnostic?.url === request?.url
			&& request?.target === "_blank"
			&& request?.features === "noopener"
			&& request?.userActivation === true,
		diagnostic,
		externalLinks: snapshot.ui.externalLinks.length,
		pointerLeaked: after.deliveredEventCounts.pointer !== pointerCount,
		request,
	};
}

async function stopChrome(chrome) {
	if (chrome.exitCode !== null) return;
	chrome.kill("SIGTERM");
	await Promise.race([
		new Promise(resolve => chrome.once("exit", resolve)),
		new Promise(resolve => setTimeout(resolve, 2_000)),
	]);
	if (chrome.exitCode === null) chrome.kill("SIGKILL");
}

/**
 * Asks Chromium to close through its own protocol before falling back to
 * process signals, avoiding the full forced-shutdown grace period on success.
 */
export async function requestBrowserClose(protocol, adapters = {}) {
	const grace = adapters.grace
		?? (() => new Promise(resolveGrace => setTimeout(resolveGrace, 250)));
	try {
		await Promise.race([
			protocol.send("Browser.close"),
			grace(),
		]);
	} catch {
		// A successful Browser.close may tear down the protocol before replying.
	}
}

/**
 * Removes Chrome's profile in bounded whole-tree passes because late helper
 * processes can recreate entries after Node's per-system-call retries expire.
 */
export async function removeBrowserProfile(profile, adapters = {}) {
	const remove = adapters.remove ?? rmSync;
	const retry = adapters.retry ?? (() => new Promise(resolveRetry => setTimeout(resolveRetry, 50)));
	for (let attempt = 0; ; attempt += 1) {
		try {
			remove(profile, {
				force: true,
				maxRetries: 8,
				recursive: true,
				retryDelay: 25,
			});
			return;
		} catch (error) {
			const retryable = ["EBUSY", "ENOTEMPTY", "EPERM"].includes(error?.code);
			if (!retryable || attempt >= 7) throw error;
			await retry();
		}
	}
}

async function inspect(options) {
	const verboseEvents = process.env.AEDICULE_BROWSER_TRACE_EVENTS === "1";
	const chromePath = resolveChrome(options.chrome);
	const profile = mkdtempSync(join(tmpdir(), "aedicule-headless-chrome."));
	const chromeErrors = [];
	const chrome = spawn(chromePath, [
		"--headless=new",
		"--no-sandbox",
		"--mute-audio",
		"--disable-background-networking",
		"--disable-component-update",
		"--enable-unsafe-webgpu",
		"--enable-unsafe-swiftshader",
		"--use-webgpu-adapter=swiftshader",
		"--use-gl=angle",
		"--use-angle=swiftshader",
		"--remote-debugging-port=0",
		`--user-data-dir=${profile}`,
		"about:blank",
	], {
		env: browserProcessEnvironment(profile),
		stdio: ["ignore", "ignore", "pipe"],
	});
	chrome.stderr.setEncoding("utf8");
	chrome.stderr.on("data", data => {
		chromeErrors.push(...data.split("\n").filter(Boolean));
		if (chromeErrors.length > 80) chromeErrors.splice(0, chromeErrors.length - 80);
	});

	let socket;
	let protocol;
	try {
		const portFile = join(profile, "DevToolsActivePort");
		await waitForFile(portFile, options.timeoutMs);
		const [port] = readFileSync(portFile, "utf8").trim().split("\n");
		const page = await waitForDebuggablePage(port, options.timeoutMs);
		socket = await connect(page.webSocketDebuggerUrl, options.timeoutMs);
		protocol = createProtocol(socket);
		const stages = new Map();
		const exceptions = [];
		const inputDiagnostics = [];
		let startupFailure;
		let settle;
		const settled = new Promise(resolve => { settle = resolve; });

		protocol.onEvent(message => {
			if (message.method === "Runtime.exceptionThrown") {
				const exception = message.params.exceptionDetails.exception?.description
					?? message.params.exceptionDetails.text;
				const firstOccurrence = !exceptions.includes(exception);
				exceptions.push(exception);
				if (verboseEvents || firstOccurrence) {
					process.stderr.write(`${JSON.stringify({ type: "exception", exception })}\n`);
				}
				return;
			}
			if (message.method !== "Runtime.consoleAPICalled") return;
			const values = message.params.args.map(remoteValue);
			if (values[0] === "[Aedicule startup]") {
				const stage = values[1];
				let detail = values[2] ?? {};
				try { detail = JSON.parse(detail); } catch { /* Preserve non-JSON diagnostics. */ }
				stages.set(stage, detail);
				process.stdout.write(`${JSON.stringify({ type: "stage", stage, detail })}\n`);
				if (stage === "settled") settle();
			} else if (values[0] === "[Aedicule startup] failed") {
				startupFailure = values.slice(1).join(" ");
				process.stderr.write(`${JSON.stringify({ type: "startup-failure", detail: startupFailure })}\n`);
				settle();
			} else if (values[0] === "[Aedicule input]") {
				const input = { phase: values[1], detail: values[2] };
				try { input.detail = JSON.parse(input.detail); } catch { /* Preserve non-JSON diagnostics. */ }
				inputDiagnostics.push(input);
				if (verboseEvents) {
					process.stdout.write(`${JSON.stringify({ type: "input-observed", ...input })}\n`);
				}
			}
		});

		await protocol.send("Runtime.enable");
		await protocol.send("Page.enable");
		await protocol.send("Page.addScriptToEvaluateOnNewDocument", {
			source: inputObserverSource(verboseEvents, options.requireExternalLink),
		});
		await protocol.send("Page.navigate", { url: options.url });
		if (options.localApplication !== undefined) {
			await selectLocalApplication(protocol, options.localApplication, options.timeoutMs);
		}
		await withTimeout(settled, options.timeoutMs, "Aedicule's settled startup stage");
		const snapshot = await pageSnapshot(protocol);
		process.stdout.write(`${JSON.stringify({ type: "snapshot", ...snapshot })}\n`);
		const inputSummary = await synthesizeInput(protocol, snapshot, verboseEvents);
		process.stdout.write(`${JSON.stringify({
			type: "input-summary",
			...inputSummary,
			diagnostics: inputDiagnostics.length,
		})}\n`);
		if (options.requireAudioPlayback) await waitForAudioPlayback(protocol);
		const finalSnapshot = await pageSnapshot(protocol);
		const controlSummary = options.requireControls
			? await exerciseControls(protocol, finalSnapshot)
			: undefined;
		if (controlSummary !== undefined) {
			process.stdout.write(`${JSON.stringify({
				type: "control-summary",
				...controlSummary,
			})}\n`);
		}
		const externalLinkSummary = options.requireExternalLink
			? await exerciseExternalLink(protocol, await pageSnapshot(protocol))
			: undefined;
		if (externalLinkSummary !== undefined) {
			process.stdout.write(`${JSON.stringify({
				type: "external-link-summary",
				...externalLinkSummary,
			})}\n`);
		}

		const missingStages = EXPECTED_STAGES.filter(stage => !stages.has(stage));
		const drawableCanvas = finalSnapshot.canvases.some(canvas =>
			canvas.bufferWidth > 1 && canvas.bufferHeight > 1
			&& canvas.cssWidth > 0 && canvas.cssHeight > 0);
		const missingInput = [
			["mousemove", 1],
			["wheel", 1],
			["keydown", 1],
			["keyup", 1],
		].filter(([type, count]) => (inputSummary.observed[type] ?? 0) < count);
		const missingMousePointer = [
			["pointerdown", 3],
			["pointerup", 3],
		].filter(([type, count]) => (inputSummary.mousePointerPhases?.[type] ?? 0) < count);
		const missingTouch = [
			["pointerdown", 3],
			["pointermove", 2],
			["pointerup", 2],
			["pointercancel", 1],
		].filter(([type, count]) => (inputSummary.touchPhases?.[type] ?? 0) < count);
		const failures = [];
		if (startupFailure !== undefined) failures.push(`startup failed: ${startupFailure}`);
		if (missingStages.length > 0) failures.push(`missing startup stages: ${missingStages.join(", ")}`);
		if (exceptions.length > 0) {
			failures.push(`${exceptions.length} uncaught browser exception(s), ${new Set(exceptions).size} unique`);
		}
		if (!drawableCanvas) failures.push("GPUI produced no drawable canvas larger than 1x1");
		if (finalSnapshot.status !== null) failures.push(`startup status remained visible: ${finalSnapshot.status}`);
		if (finalSnapshot.runtime?.inProgress
			|| finalSnapshot.runtime?.framesCompleted <= snapshot.runtime?.framesCompleted) {
			failures.push("Aedicule runtime did not complete another browser frame after startup");
		}
		if (options.requireAudioPlayback) {
			failures.push(...audioPlaybackFailures(
				finalSnapshot.audioDiagnostic?.timeline ?? [],
			));
		}
		if (options.requireKeyDelivery && !inputSummary.keyFrameChanged) {
			failures.push("W/A/D down/up edges did not all produce the guest's committed frame change");
		}
		if (!inputSummary.chordDelivered || inputSummary.chordPointerDelta < 3) {
			failures.push(
				"secondary-up was lost while primary remained held in a browser mouse chord",
			);
		}
		if (inputSummary.hiddenInputTouchFocusRequests !== 0) {
			failures.push(
				"touch input focused GPUI Web's hidden input and can summon a software keyboard",
			);
		}
		if (!inputSummary.inputQuiesced) {
			failures.push("synthetic guest input did not quiesce before control acceptance");
		}
		if (options.requireControls && (
			controlSummary.buttons < 1
			|| controlSummary.sliders < 1
			|| !controlSummary.buttonDelivered
			|| !controlSummary.sliderDelivered
			|| controlSummary.pointerLeaked
		)) {
			failures.push(
				"AVP controls were absent, failed semantic delivery, or leaked into canvas input",
			);
		}
		if (options.requireExternalLink && (
			externalLinkSummary.externalLinks < 1
			|| !externalLinkSummary.activated
			|| externalLinkSummary.pointerLeaked
		)) {
			failures.push(
				"AVP external link was absent, lacked trusted noopener activation, or leaked into canvas input",
			);
		}
		if (missingInput.length > 0) {
			failures.push(`synthetic input was not observed: ${missingInput.map(([type]) => type).join(", ")}`);
		}
		if (missingMousePointer.length > 0) {
			failures.push(`synthetic mouse-pointer input was not observed: ${missingMousePointer.map(([type]) => type).join(", ")}`);
		}
		if (missingTouch.length > 0 || inputSummary.touchContacts?.length !== 3) {
			failures.push("synthetic multi-touch identity/phases were not preserved at the DOM");
		}
		if (failures.length > 0) throw new Error(failures.join("; "));
	} catch (error) {
		const relevantChromeErrors = chromeErrors.filter(line =>
			!line.startsWith("DevTools listening on ")
			&& !line.includes("google_apis/gcm/engine/registration_request.cc"));
		if (relevantChromeErrors.length > 0) {
			process.stderr.write(`${JSON.stringify({ type: "chrome-stderr-tail", lines: relevantChromeErrors })}\n`);
		}
		throw error;
	} finally {
		if (protocol !== undefined) await requestBrowserClose(protocol);
		if (socket !== undefined) socket.close();
		await stopChrome(chrome);
		await removeBrowserProfile(profile);
	}
}

async function main(options) {
	let staticServer;
	try {
		if (options.staticRoot !== undefined) {
			staticServer = await startStaticServer(options.staticRoot);
			options = { ...options, url: staticServer.url };
		}
		await inspect(options);
	} finally {
		if (staticServer !== undefined) await staticServer.close();
	}
}

if (process.argv[1] !== undefined
	&& import.meta.url === pathToFileURL(resolve(process.argv[1])).href) {
	try {
		await main(parseArguments(process.argv.slice(2)));
	} catch (error) {
		process.stderr.write(`web_browser_startup: ${error.message}\n`);
		process.exitCode = 1;
	}
}
