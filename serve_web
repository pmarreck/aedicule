#!/usr/bin/env bash

set -u

usage() {
	printf 'usage: ./serve_web [--listen ADDRESS]\n\n'
	printf 'Build and serve the exact browser delivery locally without deploying it.\n'
	printf 'Default: http://127.0.0.1:8910/\n'
}

AEDICULE_WEB_DISPLAY=http://127.0.0.1:8910
AEDICULE_WEB_BIND=127.0.0.1
AEDICULE_WEB_LISTEN=http://:8910

while (( $# != 0 )); do
	case "$1" in
		-h|--help)
			usage
			exit 0
			;;
		--listen)
			if (( $# < 2 )); then
				printf 'serve_web: --listen requires ADDRESS\n' >&2
				exit 2
			fi
			AEDICULE_WEB_DISPLAY=$2
			shift 2
			;;
		--listen=*)
			AEDICULE_WEB_DISPLAY=${1#--listen=}
			shift
			;;
		*)
			printf 'serve_web: unknown argument: %s\n' "$1" >&2
			exit 2
			;;
	esac
done

if [[ -z $AEDICULE_WEB_DISPLAY ]]; then
	printf 'serve_web: listen address must not be empty\n' >&2
	exit 2
fi
case "$AEDICULE_WEB_DISPLAY" in
	http://*|https://*) ;;
	*) AEDICULE_WEB_DISPLAY="http://$AEDICULE_WEB_DISPLAY" ;;
esac
if [[ $AEDICULE_WEB_DISPLAY =~ ^(http|https)://(\[[^]]+\]|[^:/]+):([0-9]+)$ ]]; then
	scheme=${BASH_REMATCH[1]}
	host=${BASH_REMATCH[2]}
	port=${BASH_REMATCH[3]}
else
	printf 'serve_web: invalid listen address: %s\n' "$AEDICULE_WEB_DISPLAY" >&2
	exit 2
fi
if (( port < 1 || port > 65535 )); then
	printf 'serve_web: listen port must be between 1 and 65535\n' >&2
	exit 2
fi
AEDICULE_WEB_BIND=${host#[}
AEDICULE_WEB_BIND=${AEDICULE_WEB_BIND%]}
AEDICULE_WEB_LISTEN="$scheme://:$port"

webroot=$(nix build .#delivery-web --no-link --print-out-paths) || exit $?
export AEDICULE_WEB_BIND AEDICULE_WEB_LISTEN
printf '%s/\n' "${AEDICULE_WEB_DISPLAY%/}"
exec nix run .#webServe -- "$webroot"
