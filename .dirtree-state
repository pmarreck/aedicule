ver=1.2
depth=3

annotate=[
	.github/workflows/ci.yml = Public GitHub Actions gate that runs the canonical reproducible Nix build and release-profile tests
	Cargo.toml = Rust package metadata, GUI feature, pinned GPUI dependencies, and local tracing compatibility patches
	FIDELITY_GAP_MATRIX.md = Source-to-WAT implementation ledger, deliberate deviations, remaining fidelity gaps, and completion gate
	MEMORIES = Project-specific durable lessons discovered during the spike
